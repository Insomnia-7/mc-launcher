<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="using:Avalonia.Data.Converters" xmlns:local="using:Launcher.Desktop" xmlns:views="using:Launcher.Desktop.Views" xmlns:vm="using:Launcher.App.ViewModels" xmlns:icons="using:Launcher.Desktop.Controls"
        x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.MainWindow" Title="方隅" Icon="avares://MCLauncher.Desktop/Assets/Brand/fangyu.ico" Width="1280" Height="820" MinWidth="900" MinHeight="560" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TransparencyBackgroundFallback="{DynamicResource BgBrush}">
  <Window.Styles>
    <Style Selector="Button.caption"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="38"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="0"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RenderTransform" Value="none"/></Style>
    <Style Selector="Button.caption.close:pointerover /template/ Border#Surface"><Setter Property="Background" Value="#C42B1C"/></Style>
    <Style Selector="Button.caption.close:pointerover"><Setter Property="Foreground" Value="White"/></Style>
    <Style Selector="Button.caption:pressed"><Setter Property="RenderTransform" Value="none"/></Style>
    <Style Selector="Window.inactive TextBlock#TitleText, Window.inactive StackPanel#CaptionButtons"><Setter Property="Opacity" Value="0.65"/></Style>
    <Style Selector="Border#SidebarPanel"><Setter Property="Width" Value="216"/><Setter Property="Background" Value="{DynamicResource PanelBrush}"/></Style>
    <Style Selector="Border#SidebarPanel.nav-minimal"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Border#SidebarPanel.nav-overlay"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BoxShadow" Value="0 8 32 0 #33000000"/></Style>
    <Style Selector="Border#SidebarPanel.nav-compact"><Setter Property="Padding" Value="6,16,6,12"/></Style>
    <Style Selector="Border#SidebarPanel.nav-compact icons|IconLabel TextBlock"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Border#SidebarPanel.nav-compact icons|IconLabel StackPanel"><Setter Property="Spacing" Value="0"/></Style>
    <Style Selector="Border#SidebarPanel.nav-compact Button.nav"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Padding" Value="10"/></Style>
    <Style Selector="Button.shell-nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style Selector="Button.shell-nav.active"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="Button.shell-nav.active /template/ Border#Surface"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ToggleButton.sidebar-toggle"><Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="MinHeight" Value="32"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="Window.maximized Border#WindowOutline"><Setter Property="IsVisible" Value="False"/></Style>
  </Window.Styles>
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+1" Command="{Binding ShowHomeCommand}"/>
    <KeyBinding Gesture="Ctrl+2" Command="{Binding ShowInstancesCommand}"/>
    <KeyBinding Gesture="Ctrl+3" Command="{Binding OpenMultiplayerCommand}"/>
    <KeyBinding Gesture="Ctrl+4" Command="{Binding ShowDownloadsCommand}"/>
    <KeyBinding Gesture="Ctrl+J" Command="{Binding OpenTaskCenterCommand}"/>
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenAppearanceCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding CloseTopOverlayCommand}"/>
  </Window.KeyBindings>
  <Grid x:Name="Shell" RowDefinitions="52,*,Auto" ColumnDefinitions="Auto,*" Margin="{Binding $parent[Window].OffScreenMargin}">
    <Border x:Name="WindowHeader" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0">
      <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,0,6,0" ColumnSpacing="16">
        <Border x:Name="TitleDragArea" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar">
          <Grid ColumnDefinitions="38,*" ColumnSpacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
            <Image x:Name="TitleAppIcon" Source="avares://MCLauncher.Desktop/Assets/Brand/fangyu.png" Width="34" Height="34"/>
            <StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="TitleText" Text="方隅" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="TitleEdition" Text="Minecraft 启动器" FontSize="10" Classes="muted"/></StackPanel>
          </Grid>
        </Border>
        <Button x:Name="HeaderAccountButton" Grid.Column="1" Classes="quiet" MaxWidth="200" Padding="8,4" AutomationProperties.Name="账号与角色" WindowDecorationProperties.ElementRole="User">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Grid Width="24" Height="24"><icons:UiIcon Kind="ActionLogin" IsVisible="{Binding !HasSkinHead}"/><Image Source="{Binding SkinHead}" IsVisible="{Binding HasSkinHead}" RenderOptions.BitmapInterpolationMode="None"/></Grid>
            <TextBlock Text="{Binding AccountText}" MaxWidth="130" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <TextBlock Text="⌄" FontSize="12" VerticalAlignment="Center"/>
          </StackPanel>
          <Button.Flyout><MenuFlyout><MenuItem Header="管理账号" Command="{Binding OpenAccountsCommand}"/><MenuItem Header="角色与皮肤" Command="{Binding OpenWardrobeCommand}"/></MenuFlyout></Button.Flyout>
        </Button>
        <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2" WindowDecorationProperties.ElementRole="User">
          <Button x:Name="HeaderTaskButton" Classes="caption" Command="{Binding OpenTaskCenterCommand}" ToolTip.Tip="查看下载任务" AutomationProperties.Name="查看下载任务"><icons:UiIcon Kind="NavBell" Width="16" Height="16" Foreground="{DynamicResource MutedBrush}"/></Button>
          <Button x:Name="ThemeSwitchButton" Classes="caption" Command="{Binding CycleThemeModeCommand}" ToolTip.Tip="{Binding ThemeModeTooltip}" AutomationProperties.Name="切换主题"><Path Data="{Binding ThemeModeIconGeometry}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform"/></Button>
          <Button x:Name="MinimizeButton" Classes="caption" Click="MinimizeWindow" WindowDecorationProperties.ElementRole="MinimizeButton" ToolTip.Tip="最小化" AutomationProperties.Name="最小化"><Path Data="M 2,8 H 14" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Width="16" Height="16"/></Button>
          <Button x:Name="MaximizeButton" Classes="caption" Click="ToggleMaximizeWindow" WindowDecorationProperties.ElementRole="MaximizeButton" ToolTip.Tip="最大化" AutomationProperties.Name="最大化"><Path x:Name="MaximizeGlyph" Data="M 2,2 L 12,2 12,12 2,12 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.2" Width="14" Height="14"/></Button>
          <Button x:Name="CloseWindowButton" Classes="caption close" Click="CloseWindow" WindowDecorationProperties.ElementRole="CloseButton" ToolTip.Tip="关闭" AutomationProperties.Name="关闭窗口"><icons:UiIcon Kind="ActionClose" Width="16" Height="16" Foreground="{Binding $parent[Button].Foreground}"/></Button>
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="SidebarPanel" Grid.Row="1" Grid.RowSpan="2" Padding="16,8,12,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0" ClipToBounds="True">
      <Grid RowDefinitions="*,Auto,Auto" RowSpacing="0">
        <Grid x:Name="SidebarBrandHost" Grid.Row="1" Height="40">
          <Grid x:Name="SidebarBrandExpanded" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel x:Name="SidebarNavText" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="MINECRAFT" Classes="eyebrow" FontSize="10" LetterSpacing="1.5"/></StackPanel>
            <ToggleButton x:Name="SidebarToggle" Grid.Column="1" Classes="sidebar-toggle" IsChecked="{Binding IsSidebarCollapsed, Mode=TwoWay}" ToolTip.Tip="收起导航" AutomationProperties.Name="收起或展开导航"><icons:UiIcon Kind="ActionMenu" Width="16" Height="16"/></ToggleButton>
          </Grid>
          <StackPanel x:Name="SidebarBrandCollapsed" IsVisible="False" HorizontalAlignment="Center"><ToggleButton x:Name="SidebarToggleCollapsed" Classes="sidebar-toggle" IsChecked="{Binding IsSidebarCollapsed, Mode=TwoWay}" ToolTip.Tip="展开导航" AutomationProperties.Name="展开导航"><icons:UiIcon Kind="ActionMenu" Width="16" Height="16"/></ToggleButton></StackPanel>
        </Grid>
        <Grid Grid.Row="0">
          <Border x:Name="NavSelection" CornerRadius="8" Background="{DynamicResource NavSelectedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" IsVisible="False"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
          <DockPanel x:Name="NavList" LastChildFill="False">
            <StackPanel DockPanel.Dock="Bottom" Spacing="4">
              <Button x:Name="LauncherUpdateNotice" Content="有新版本" Classes="link" Command="{Binding OpenLauncherUpdatesCommand}" IsVisible="{Binding HasUpdate}" FontSize="12"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="4">
              <Button x:Name="HomeNav" Classes="nav shell-nav" ToolTip.Tip="主页" Classes.active="{Binding IsHomePage}" Command="{Binding ShowHomeCommand}" AutomationProperties.Name="主页"><icons:IconLabel Icon="NavHome" Text="主页" IconSize="18"/></Button>
              <Button x:Name="LibraryNav" Classes="nav shell-nav" ToolTip.Tip="实例" Classes.active="{Binding IsLibraryPage}" Command="{Binding ShowInstancesCommand}" AutomationProperties.Name="游戏实例"><icons:IconLabel Icon="NavVersions" Text="游戏实例" IconSize="18"/></Button>
              <Button x:Name="MultiplayerNav" Classes="nav shell-nav" ToolTip.Tip="联机" Classes.active="{Binding IsMultiplayerPage}" Command="{Binding OpenMultiplayerCommand}" AutomationProperties.Name="联机大厅"><icons:IconLabel Icon="NavPeople" Text="联机大厅" IconSize="18"/></Button>
              <Button x:Name="NetworkNav" Classes="nav shell-nav" ToolTip.Tip="网络与连接" Classes.active="{Binding IsNetworkSettingsPage}" Command="{Binding OpenNetworkCommand}" AutomationProperties.Name="网络与连接"><icons:IconLabel Icon="NetworkWifi" Text="网络与连接" IconSize="18"/></Button>
              <Button x:Name="DiscoverNav" Classes="nav shell-nav" ToolTip.Tip="资源" Classes.active="{Binding IsDiscoverPage}" Command="{Binding ShowDownloadsCommand}" AutomationProperties.Name="资源管理"><icons:IconLabel Icon="ActionFolder" Text="资源管理" IconSize="18"/></Button>
              <Button x:Name="TaskCenterEntry" Classes="nav shell-nav" ToolTip.Tip="下载" Classes.active="{Binding IsTaskPage}" Command="{Binding OpenTaskCenterCommand}" AutomationProperties.Name="下载中心"><Grid><icons:IconLabel Icon="NavDownload" Text="下载中心" IconSize="18"/><Border x:Name="SidebarTaskBadge" IsVisible="{Binding HasSidebarTasks}" Background="{DynamicResource AccentFillBrush}" CornerRadius="6" MinWidth="16" Height="16" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock Text="{Binding SidebarTaskCount}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="10"/></Border></Grid></Button>
              <Button x:Name="SettingsEntry" Classes="nav shell-nav" ToolTip.Tip="设置" Classes.active="{Binding IsGeneralSettingsPage}" Command="{Binding OpenAppearanceCommand}" AutomationProperties.Name="设置"><icons:IconLabel Icon="NavGear" Text="设置" IconSize="18"/></Button>
              <Button x:Name="WardrobeEntry" IsVisible="False" Command="{Binding OpenWardrobeCommand}"/>
              <Button x:Name="ShowcaseNav" Classes="nav shell-nav" IsVisible="{Binding IsDevShowcaseEnabled}" Command="{Binding OpenShowcaseCommand}" Content="开发预览"/>
            </StackPanel>
          </DockPanel>
          <Border x:Name="NavIndicator" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentBrush}" IsHitTestVisible="False" IsVisible="False"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
        </Grid>
        <StackPanel x:Name="SidebarBottomText" Grid.Row="2" Margin="12,0" Spacing="4"><TextBlock Text="{Binding InstanceCountText}" Classes="label"/><TextBlock Text="Java / Rust" FontSize="10" Foreground="{DynamicResource FaintBrush}"/></StackPanel>
        <StackPanel x:Name="SidebarBottomCompact" Grid.Row="2" IsVisible="False"/>
      </Grid>
    </Border>
    <Border x:Name="SidebarScrim" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Background="{DynamicResource ScrimBrush}" IsVisible="False" ZIndex="8" PointerPressed="OnScrimPressed"/>
    <Grid x:Name="PageContent" Grid.Row="1" Grid.Column="1"><icons:AnimatedContentHost x:Name="PageHost" Background="{DynamicResource BgBrush}"/></Grid>
    <Button x:Name="SidebarHamburger" Grid.Row="1" Grid.Column="1" Classes="icon" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" ZIndex="7" IsVisible="False" Click="OpenOverlaySidebar"><icons:UiIcon Kind="ActionMenu"/></Button>
    <Border x:Name="StatusBar" Grid.Row="2" Grid.Column="1" Padding="24,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
      <Border.IsVisible><MultiBinding Converter="{x:Static conv:BoolConverters.Or}"><Binding Path="HasSidebarTasks"/><Binding Path="HasStatusText"/></MultiBinding></Border.IsVisible>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><TextBlock Text="{Binding StatusText}" FontSize="11" Classes="muted" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="link" Command="{Binding OpenTaskCenterCommand}" IsVisible="{Binding HasSidebarTasks}" MinHeight="24" Padding="0"><StackPanel Orientation="Horizontal" Spacing="8"><icons:UiIcon Kind="NavDownload" Width="14" Height="14" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding SidebarTaskCount}" FontSize="11"/><TextBlock Text="项任务 · 查看" FontSize="11"/></StackPanel></Button></Grid>
    </Border>
    <Border x:Name="WindowOutline" Grid.RowSpan="3" Grid.ColumnSpan="2" ZIndex="20" BorderThickness="1" BorderBrush="{DynamicResource BorderSubtleBrush}" IsHitTestVisible="False"/>
    <views:ToastHost x:Name="Notifications" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" DataContext="{Binding Toasts}" Width="360" MaxWidth="360" Margin="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" ZIndex="30"/>
    <ContentControl x:Name="OverlayHost" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False" ZIndex="25"/>
  </Grid>
</Window>
