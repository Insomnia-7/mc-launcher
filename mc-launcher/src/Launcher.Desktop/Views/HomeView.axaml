<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Launcher.App.ViewModels" xmlns:icons="using:Launcher.Desktop.Controls" x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.Views.HomeView">
  <UserControl.Styles>
    <Style Selector="UserControl.compact Grid#HomeLayout"><Setter Property="Margin" Value="24,24,24,20"/></Style>
    <Style Selector="UserControl.compact TextBlock#HomeGreeting"><Setter Property="FontSize" Value="24"/></Style>
    <Style Selector="UserControl.compact Border#HomeQuickLaunchCard"><Setter Property="Padding" Value="20"/></Style>
    <Style Selector="UserControl.compact Grid#HomeScenery"><Setter Property="IsVisible" Value="False"/></Style>
    <Style Selector="Grid.recent-row:pointerover"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Style>
  </UserControl.Styles>
  <ScrollViewer x:Name="HomeScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <Grid x:Name="HomeLayout" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="28" Margin="40,32,40,24" MaxWidth="1320" HorizontalAlignment="Stretch">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="8"><TextBlock Text="MINECRAFT · JAVA EDITION" Classes="eyebrow" FontSize="10" LetterSpacing="1.8"/><TextBlock x:Name="HomeGreeting" Text="下一次冒险，从这里开始。" Classes="page-title"/></StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding HomeLastPlayedText}" Classes="label" VerticalAlignment="Bottom"/>
      </Grid>
      <Border x:Name="HomeQuickLaunchCard" Grid.Row="1" Classes="card" Padding="28" CornerRadius="16">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="24">
          <Grid x:Name="HomeLaunchContent" ColumnDefinitions="1.45*,1*" ColumnSpacing="24">
            <StackPanel Spacing="12" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8"><Border Background="{DynamicResource SelectedBrush}" CornerRadius="4" Padding="7,3"><TextBlock Text="启动 Minecraft" Foreground="{DynamicResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding SelectedGameStatus}" Classes="label" VerticalAlignment="Center" IsVisible="{Binding HasInstances}"/></StackPanel>
              <TextBlock x:Name="HomeSelectedName" Text="{Binding SelectedGameName}" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasInstances}"/>
              <TextBlock Text="{Binding SelectedGameMeta}" Classes="muted" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasInstances}"/>
              <StackPanel x:Name="HomeEmptyLibrary" IsVisible="{Binding !HasInstances}" Spacing="10"><TextBlock Text="开始你的第一个世界" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="安装 Minecraft，或导入喜欢的整合包。" Classes="muted" TextWrapping="Wrap"/></StackPanel>
              <Button x:Name="HomeAccountEntry" Classes="quiet" Command="{Binding OpenAccountsCommand}" HorizontalAlignment="Left" Padding="0,4" AutomationProperties.Name="选择游戏账号"><StackPanel Orientation="Horizontal" Spacing="8"><Grid Width="20" Height="20"><Image Source="{Binding SkinHead}" IsVisible="{Binding HasSkinHead}" RenderOptions.BitmapInterpolationMode="None"/><icons:UiIcon Kind="ActionLogin" IsVisible="{Binding !HasSkinHead}" Width="18" Height="18" Foreground="{DynamicResource MutedBrush}"/></Grid><TextBlock Text="{Binding AccountText}" FontSize="12" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Text="切换 ›" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
            <Grid x:Name="HomeScenery" Grid.Column="1" Height="160" IsHitTestVisible="False"><Border CornerRadius="12" ClipToBounds="True"><Grid><Image Source="{Binding WallpaperImage}" Opacity="{Binding WallpaperOpacity}" Stretch="UniformToFill" IsVisible="{Binding HasCustomWallpaper}"/><icons:WorldArt IsVisible="{Binding !HasCustomWallpaper}"/></Grid></Border></Grid>
          </Grid>
          <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="12">
            <Grid ColumnDefinitions="*,160" ColumnSpacing="12" IsVisible="{Binding HasInstances}">
              <ComboBox x:Name="QuickInstanceSelector" ItemsSource="{Binding HomeEntries}" SelectedItem="{Binding SelectedHomeEntry, Mode=TwoWay}" MinHeight="46" PlaceholderText="选择 Minecraft 实例" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="选择要启动的游戏实例">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryEntry"><Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="10"><icons:InstanceTypeIcon Kind="{Binding TypeIcon}" Width="24" Height="24"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding LoaderBadgeText}" Classes="label" VerticalAlignment="Center"/></Grid></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="HomeLaunchButton" Grid.Column="1" Classes="primary" Command="{Binding LaunchCommand}" Height="46" AutomationProperties.Name="启动游戏"><icons:IconLabel Icon="ActionPlay" Text="{Binding LaunchTitle}" IconSize="20" FontSize="14" Foreground="{Binding $parent[Button].Foreground}"/></Button>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding !HasInstances}"><Button x:Name="HomeCreateFirstButton" Classes="primary" Command="{Binding OpenSetupCommand}" Height="46" Content="安装 Minecraft"/><Button x:Name="HomeImportFirstButton" Command="{Binding ImportModpackCommand}" Height="46" Content="导入整合包"/></StackPanel>
            <Grid x:Name="HomeLaunchProgress" Grid.Row="1" IsVisible="{Binding IsBusy}" ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="8"><TextBlock Text="{Binding StatusText}" Classes="label" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="3"/></StackPanel><Button x:Name="HomeCancelLaunch" Grid.Column="1" Classes="link" Command="{Binding CancelCommand}" Content="取消" IsVisible="{Binding CanCancel}"/></Grid>
          </Grid>
        </Grid>
      </Border>
      <Grid x:Name="HomeBottomRow" Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="24">
        <StackPanel x:Name="HomeInstancesCard" Spacing="12">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="最近使用" Classes="section-title" VerticalAlignment="Center"/><Button x:Name="HomeAllInstances" Grid.Column="1" Classes="link" Command="{Binding ShowInstancesCommand}" Content="{Binding AllInstancesLinkText}"/></Grid>
          <ItemsControl x:Name="HomeInstancesList" ItemsSource="{Binding RecentHomeEntries}" IsVisible="{Binding HasInstances}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:LibraryEntry">
              <Grid Classes="recent-row" ColumnDefinitions="44,*,36,36" ColumnSpacing="10" Margin="0,2" Height="62" Background="Transparent">
                <Border Width="36" Height="36" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center"><Grid><Image Source="{Binding Cover}" Stretch="{Binding CoverStretch}" IsVisible="{Binding HasCover}"/><icons:InstanceTypeIcon Kind="{Binding TypeIcon}" Width="32" Height="32" IsVisible="{Binding !HasCover}"/></Grid></Border>
                <Button Grid.Column="1" Classes="quiet" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenGameCommand}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0"><StackPanel Spacing="5"><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" Classes="label" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></Button>
                <Button Grid.Column="2" Classes="icon" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).QuickLaunchEntryCommand}" CommandParameter="{Binding}" ToolTip.Tip="启动此实例" AutomationProperties.Name="启动此实例"><icons:UiIcon Kind="ActionPlay" Foreground="{DynamicResource AccentBrush}" Width="18" Height="18"/></Button>
                <Button Grid.Column="3" Classes="icon" Content="···" Click="OpenEntryMenu" ToolTip.Tip="实例操作" AutomationProperties.Name="实例操作"/>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="安装后，你的 Minecraft 实例会显示在这里。" Classes="muted" IsVisible="{Binding !HasInstances}" Margin="0,12"/>
        </StackPanel>
        <Border x:Name="HomeRuntimePanel" Grid.Column="1" Classes="card" Width="250" IsVisible="False" VerticalAlignment="Top"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="运行环境" Classes="section-title"/><Button Grid.Column="1" Classes="icon" Content="×" Click="ToggleRuntime" ToolTip.Tip="收起运行环境"/></Grid><StackPanel Spacing="6"><TextBlock Text="内存" Classes="label"/><TextBlock Text="{Binding MemoryText}" FontSize="20" FontWeight="SemiBold"/></StackPanel><StackPanel Spacing="6"><TextBlock Text="Java" Classes="label"/><TextBlock Text="{Binding HomeJavaSummary}" TextWrapping="Wrap" FontSize="13"/></StackPanel><Button Content="管理当前实例" Command="{Binding OpenGameCommand}" IsEnabled="{Binding HasInstances}"/></StackPanel></Border>
      </Grid>
      <WrapPanel x:Name="HomeShortcuts" Grid.Row="3">
        <Button x:Name="HomeNewInstance" Classes="quiet" Command="{Binding OpenSetupCommand}" Margin="0,0,8,8"><icons:IconLabel Icon="ActionPlus" Text="安装新版本" IconSize="16" FontSize="12"/></Button>
        <Button x:Name="HomeImportModpack" Classes="quiet" Command="{Binding ImportModpackCommand}" Margin="0,0,8,8"><icons:IconLabel Icon="ActionImport" Text="导入整合包" IconSize="16" FontSize="12"/></Button>
        <Button x:Name="HomeRuntimeToggle" Classes="quiet" Click="ToggleRuntime" Margin="0,0,0,8" IsEnabled="{Binding HasInstances}"><icons:IconLabel Icon="ActionSettings" Text="运行环境" IconSize="16" FontSize="12"/></Button>
      </WrapPanel>
      <Border x:Name="HomeConnectionSummary" Grid.Row="4" Background="{DynamicResource SelectedBrush}" CornerRadius="8" Padding="12" IsVisible="{Binding Multiplayer.HasSession}"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding HomeMultiplayerStateText}" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="link" Content="查看联机 ›" Command="{Binding OpenMultiplayerCommand}"/></Grid></Border>
    </Grid>
  </ScrollViewer>
</UserControl>
