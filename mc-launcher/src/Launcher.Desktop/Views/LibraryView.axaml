<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Launcher.App.ViewModels" xmlns:icons="using:Launcher.Desktop.Controls" xmlns:accounts="using:Launcher.Application.Accounts" xmlns:experience="using:Launcher.Application.Experience" xmlns:conv="using:Avalonia.Data.Converters" x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.Views.LibraryView">
  <ScrollViewer x:Name="LibraryScroll" Focusable="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
    <StackPanel Spacing="20" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="5">
          <TextBlock Text="游戏库" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding WorldCaption}" Classes="muted"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Command="{Binding OpenSetupCommand}">
          <icons:IconLabel Icon="ActionPlus" Text="添加游戏" Foreground="{Binding $parent[Button].Foreground}"/>
        </Button>
      </Grid>
      <Border Classes="card" Padding="24" MinHeight="216">
        <Grid RowDefinitions="*,Auto" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="8" ZIndex="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border Background="{DynamicResource SelectedBrush}" CornerRadius="6" Padding="9,5">
                <TextBlock Text="继续游玩" FontSize="12" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Text="JAVA EDITION" Classes="eyebrow" FontSize="8" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="WorldVersion" Text="{Binding WorldVersion}" FontSize="34" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
            <TextBlock Text="{Binding WorldDisplayName}" Classes="muted" TextTrimming="CharacterEllipsis" FontSize="16" IsVisible="{Binding HasWorldDisplayName}"/>
            <TextBlock Text="{Binding WorldKind}" Classes="muted"/>
          </StackPanel>
          <Grid Grid.Column="1" Width="160" Height="110" IsHitTestVisible="False">
            <Border CornerRadius="12" ClipToBounds="True" IsVisible="{Binding HasGameCover}">
              <Image Source="{Binding SelectedGameCover}" Stretch="UniformToFill"/>
            </Border>
            <icons:WorldArt IsVisible="{Binding !HasGameCover}"/>
          </Grid>
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Grid.ColumnSpan="2" Margin="0,16,0,0">
            <Button x:Name="AccountEntry" Classes="quiet" Command="{Binding OpenAccountsCommand}" Padding="0" ToolTip.Tip="管理游戏身份">
              <Grid ColumnDefinitions="44,*">
                <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource SelectedBrush}" HorizontalAlignment="Left">
                  <Grid>
                    <icons:UiIcon Kind="{Binding HasAccount, Converter={StaticResource AccountIcon}}" IsVisible="{Binding !HasSkinHead}" Width="34" Height="34"/>
                    <Image Source="{Binding SkinHead}" IsVisible="{Binding HasSkinHead}" Stretch="UniformToFill"/>
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="{Binding AccountText}" TextTrimming="CharacterEllipsis" MaxWidth="220" FontSize="14"/>
                  <TextBlock Text="{Binding AccountDetail}" TextTrimming="CharacterEllipsis" MaxWidth="220" Classes="muted" FontSize="12"/>
                </StackPanel>
              </Grid>
            </Button>
            <Button x:Name="LaunchButton" Grid.Column="1" Classes="primary" Command="{Binding LaunchCommand}" Width="180" Height="54" FontSize="16" AutomationProperties.Name="启动游戏" IsVisible="{Binding HasInstances}">
              <icons:IconLabel Icon="ActionPlay" Text="{Binding LaunchTitle}" IconSize="22" FontSize="16" FontWeight="SemiBold" Foreground="{Binding $parent[Button].Foreground}"/>
            </Button>
            <Button Grid.Column="1" Classes="primary" Command="{Binding OpenSetupCommand}" Height="54" IsVisible="{Binding !HasInstances}" AutomationProperties.Name="添加游戏版本">
              <icons:IconLabel Icon="ActionPlus" Text="添加游戏版本" Foreground="{Binding $parent[Button].Foreground}"/>
            </Button>
          </Grid>
        </Grid>
      </Border>
      <Border Classes="card" IsVisible="{Binding IsBusy}" Padding="18">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
            <Button Grid.Column="1" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" AutomationProperties.Name="取消">
              <icons:IconLabel Icon="ActionClose" Text="取消" Foreground="{Binding $parent[Button].Foreground}"/>
            </Button>
          </Grid>
          <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4"/>
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="全部游戏" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="{Binding LibraryResultText}" Classes="muted" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
          <Button x:Name="CardsLayoutButton" Classes="nav" Classes.active="{Binding !LibraryCompact}" Command="{Binding SetLibraryLayoutCommand}" CommandParameter="cards" Content="卡片"/>
          <Button x:Name="ListLayoutButton" Classes="nav" Classes.active="{Binding LibraryCompact}" Command="{Binding SetLibraryLayoutCommand}" CommandParameter="list" Content="列表"/>
          <Button Classes="quiet" Content="导入…">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="导入整合包" Command="{Binding ImportModpackCommand}"/>
                <MenuItem Header="导入文件夹" Command="{Binding ImportFolderCommand}"/>
                <MenuItem Header="自动查找游戏目录" Command="{Binding AutoDetectGameRootCommand}"/>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
      <Grid ColumnDefinitions="*,160,Auto" ColumnSpacing="10">
        <TextBox x:Name="LibrarySearch" Text="{Binding LibraryQuery}" PlaceholderText="搜索名称、游戏版本或加载器"/>
        <ComboBox Grid.Column="1" ItemsSource="{Binding LibraryGroups}" SelectedItem="{Binding LibraryGroup}" AutomationProperties.Name="游戏分组"/>
        <CheckBox Grid.Column="2" Content="仅收藏" IsChecked="{Binding LibraryFavoritesOnly}"/>
      </Grid>
      <TextBlock Text="没有匹配的游戏，试试其他关键词或分组。" Classes="muted" IsVisible="{Binding LibraryHasNoResults}" Margin="4,16"/>
      <ItemsControl x:Name="LibraryCards" ItemsSource="{Binding LibraryEntries}" IsVisible="{Binding !LibraryCompact}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryEntry">
            <Border Classes="library-tile" Width="246" Margin="0,0,12,12" Padding="16">
              <StackPanel Spacing="12">
                <Button Classes="quiet" Padding="0" HorizontalContentAlignment="Stretch" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenGameCommand}" CommandParameter="{Binding}">
                  <StackPanel Spacing="12" Width="214">
                    <Border Height="102" CornerRadius="12" Background="{DynamicResource FieldBrush}" ClipToBounds="True">
                      <Grid>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}"/>
                        <icons:UiIcon Kind="{Binding Icon}" Width="92" Height="92" IsVisible="{Binding !HasCover}"/>
                      </Grid>
                    </Border>
                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Meta}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12"/>
                  </StackPanel>
                </Button>
                <Grid ColumnDefinitions="*,Auto">
                  <Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenGameCommand}" CommandParameter="{Binding}" Content="管理游戏"/>
                  <Button Grid.Column="1" Classes="quiet" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FavoriteGameCommand}" CommandParameter="{Binding}" Content="{Binding FavoriteText}" AutomationProperties.Name="切换收藏"/>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ListBox x:Name="LibraryList" ItemsSource="{Binding LibraryEntries}" IsVisible="{Binding LibraryCompact}" SelectionChanged="SelectGameFromList">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LibraryEntry">
            <Grid ColumnDefinitions="54,*,Auto" ColumnSpacing="14">
              <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource FieldBrush}" ClipToBounds="True">
                <Grid>
                  <Image Source="{Binding Cover}" Stretch="UniformToFill" IsVisible="{Binding HasCover}"/>
                  <icons:UiIcon Kind="{Binding Icon}" Width="38" Height="38" IsVisible="{Binding !HasCover}"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding Meta}" Classes="muted"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Classes="muted" FontSize="12"/>
                <TextBlock Text="{Binding FavoriteText}" HorizontalAlignment="Right"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Border IsVisible="{Binding HasGameRootProblem}" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding GameRootProblem}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/>
          <Button Command="{Binding ChooseGameRootCommand}" HorizontalAlignment="Left" AutomationProperties.Name="更换游戏目录">
            <icons:IconLabel Icon="ActionFolder" Text="更换游戏目录" Foreground="{Binding $parent[Button].Foreground}"/>
          </Button>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
