<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Launcher.App.ViewModels" xmlns:icons="using:Launcher.Desktop.Controls" x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.Views.LibraryView">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="24">
    <Grid x:Name="LibraryHeading" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="8"><TextBlock Text="实例" Classes="page-title"/><TextBlock Text="管理你的 Minecraft 版本与整合包。" Classes="muted"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="LibraryHorizonEntry" Content="Rust 客户端" Command="{Binding OpenHorizonCommand}"/><Button Content="导入"><Button.Flyout><MenuFlyout><MenuItem Header="导入整合包" Command="{Binding ImportModpackCommand}"/><MenuItem Header="导入文件夹" Command="{Binding ImportFolderCommand}"/><MenuItem Header="查找已有 Minecraft 目录" Command="{Binding AutoDetectGameRootCommand}"/></MenuFlyout></Button.Flyout></Button><Button Classes="primary" Command="{Binding OpenSetupCommand}"><icons:IconLabel Icon="ActionPlus" Text="新建实例" Foreground="{Binding $parent[Button].Foreground}"/></Button></StackPanel>
    </Grid>
    <Grid x:Name="LibraryFilters" Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="12">
      <Grid ColumnDefinitions="*,170,Auto" ColumnSpacing="12"><TextBox x:Name="LibrarySearch" Text="{Binding LibraryQuery}" PlaceholderText="搜索名称、Minecraft 版本或加载器" AutomationProperties.Name="搜索实例"/><ComboBox Grid.Column="1" ItemsSource="{Binding LibraryGroups}" SelectedItem="{Binding LibraryGroup}" AutomationProperties.Name="实例分组" HorizontalAlignment="Stretch"/><CheckBox Grid.Column="2" Content="收藏" IsChecked="{Binding LibraryFavoritesOnly}"/></Grid>
      <Grid x:Name="LibraryActions" Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding LibraryResultText}" Classes="label" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><Button x:Name="ListLayoutButton" Classes="nav" Classes.active="{Binding LibraryCompact}" Command="{Binding SetLibraryLayoutCommand}" CommandParameter="list" Content="列表"/><Button x:Name="CardsLayoutButton" Classes="nav" Classes.active="{Binding !LibraryCompact}" Command="{Binding SetLibraryLayoutCommand}" CommandParameter="cards" Content="紧凑卡片"/><Button x:Name="LibraryInspectorToggle" Classes="quiet" Content="详情" Click="ToggleInspector"/></StackPanel></Grid>
    </Grid>
    <Grid x:Name="LibraryBody" Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="24">
      <Grid>
        <ListBox x:Name="LibraryList" ItemsSource="{Binding LibraryEntries}" SelectedItem="{Binding SelectedHomeEntry, Mode=TwoWay}" IsVisible="{Binding LibraryCompact}" AutomationProperties.Name="Minecraft 实例列表">
          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:LibraryEntry"><Grid ColumnDefinitions="44,*,36,36" ColumnSpacing="12" MinHeight="48">
            <Border Width="40" Height="40" CornerRadius="8" ClipToBounds="True" VerticalAlignment="Center"><Grid><Image Source="{Binding Cover}" Stretch="{Binding CoverStretch}" IsVisible="{Binding HasCover}"/><icons:InstanceTypeIcon Kind="{Binding TypeIcon}" Width="36" Height="36" IsVisible="{Binding !HasCover}"/></Grid></Border>
            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Meta}" Classes="label" TextTrimming="CharacterEllipsis"/></StackPanel>
            <Button Grid.Column="2" Classes="icon" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).QuickLaunchEntryCommand}" CommandParameter="{Binding}" ToolTip.Tip="启动此实例" AutomationProperties.Name="启动此实例"><icons:UiIcon Kind="ActionPlay" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}"/></Button>
            <Button Grid.Column="3" Classes="icon" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenGameCommand}" CommandParameter="{Binding}" ToolTip.Tip="管理此实例" AutomationProperties.Name="管理此实例"><icons:UiIcon Kind="ActionSettings" Width="17" Height="17"/></Button>
          </Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !LibraryCompact}"><ItemsControl x:Name="LibraryCards" ItemsSource="{Binding LibraryEntries}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:LibraryEntry"><Border Classes="card" Width="230" Padding="16" Margin="0,0,12,12"><StackPanel Spacing="12"><Grid ColumnDefinitions="44,*" ColumnSpacing="10"><Grid Width="40" Height="40"><Image Source="{Binding Cover}" Stretch="{Binding CoverStretch}" IsVisible="{Binding HasCover}"/><icons:InstanceTypeIcon Kind="{Binding TypeIcon}" Width="36" Height="36" IsVisible="{Binding !HasCover}"/></Grid><StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding LoaderBadgeText}" Classes="label"/></StackPanel></Grid><TextBlock Text="{Binding Meta}" Classes="label" TextTrimming="CharacterEllipsis"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><Button Content="管理" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).OpenGameCommand}" CommandParameter="{Binding}"/><Button Grid.Column="1" Classes="quiet" Content="{Binding FavoriteText}" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).FavoriteGameCommand}" CommandParameter="{Binding}" ToolTip.Tip="收藏此实例"/></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        <StackPanel IsVisible="{Binding LibraryHasNoResults}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"><TextBlock Text="没有找到匹配的实例" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="试试其他关键词、分组或收藏条件。" Classes="muted"/></StackPanel>
        <StackPanel x:Name="LibraryEmpty" IsVisible="{Binding !HasInstances}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16"><icons:InstanceTypeIcon Kind="vanilla" Width="56" Height="56" HorizontalAlignment="Center"/><TextBlock Text="添加第一个 Minecraft 实例" Classes="section-title"/><Button Classes="primary" Command="{Binding OpenSetupCommand}" Content="安装 Minecraft" HorizontalAlignment="Center"/></StackPanel>
      </Grid>
      <Border x:Name="LibraryInspector" Grid.Column="1" Width="260" Classes="card" VerticalAlignment="Top" IsVisible="{Binding HasInstances}"><StackPanel Spacing="18"><TextBlock Text="当前实例" Classes="label"/><TextBlock Text="{Binding SelectedGameName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedGameMeta}" Classes="muted" TextWrapping="Wrap"/><Border Height="1" Background="{DynamicResource LineBrush}"/><StackPanel Spacing="8"><TextBlock Text="{Binding SelectedGameStatus}" FontSize="12"/><TextBlock Text="{Binding AccountText}" Classes="label" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="LaunchButton" Classes="primary" Command="{Binding LaunchCommand}" Height="44" AutomationProperties.Name="启动选中实例"><icons:IconLabel Icon="ActionPlay" Text="{Binding LaunchTitle}" Foreground="{Binding $parent[Button].Foreground}"/></Button><Button Command="{Binding OpenGameCommand}" Content="管理实例"/><Button Classes="link" Command="{Binding OpenGameDirectoryCommand}" Content="打开文件夹 ↗"/></StackPanel></Border>
    </Grid>
    <Border x:Name="GameRootStatus" Grid.Row="3" IsVisible="{Binding HasGameRootProblem}" Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding GameRootProblem}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"/><Button Command="{Binding ChooseGameRootCommand}" Content="更换游戏目录" HorizontalAlignment="Left"/></StackPanel></Border>
  </Grid>
</UserControl>
