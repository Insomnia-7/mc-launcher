<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="using:Avalonia.Data.Converters" xmlns:vm="using:Launcher.App.ViewModels" xmlns:versions="using:Launcher.Domain.Versions" x:DataType="vm:MainViewModel" xmlns:icons="using:Launcher.Desktop.Controls" x:Class="Launcher.Desktop.Views.DiscoverView">
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
    <StackPanel Spacing="7" Margin="0,0,0,18"><TextBlock Text="{Binding Download.DiscoverHeading}" FontSize="28" FontWeight="SemiBold" /><TextBlock Text="选择游戏版本，或为现有世界添加资源。" Classes="muted" FontSize="13" /></StackPanel>
    <ItemsControl Grid.Row="1" IsVisible="{Binding Download.ShowsBrowseControls}" ItemsSource="{Binding Download.Categories}" Margin="0,0,0,12" IsEnabled="{Binding Download.CanConfigureVersion}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:CategoryItem"><Button Classes="nav" Classes.active="{Binding IsSelected}" IsVisible="{Binding IsNormal}" Command="{Binding SelectCommand}" CommandParameter="{Binding}" Margin="0,0,6,6" AutomationProperties.Name="{Binding Title}"><icons:IconLabel Icon="{Binding Category, Converter={StaticResource CategoryIcon}}" Text="{Binding Title}" IconSize="24" Foreground="{Binding $parent[Button].Foreground}" /></Button></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Grid.Row="2" IsVisible="{Binding Download.ShowsBrowseControls}" Classes="card" Padding="16" Margin="0,0,0,12">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding Download.Query}" PlaceholderText="{Binding Download.SearchHint}" IsVisible="{Binding Download.IsSearchMode}"><TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding Download.SearchCommand}" /></TextBox.KeyBindings></TextBox><TextBlock Text="Minecraft 游戏版本" IsVisible="{Binding Download.IsVersionMode}" VerticalAlignment="Center" FontWeight="SemiBold" /><Button Grid.Column="1" Classes="primary" Command="{Binding Download.SearchCommand}" IsVisible="{Binding Download.IsSearchMode}" AutomationProperties.Name="搜索"><icons:IconLabel Icon="ActionSearch" Text="搜索" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Grid.Column="2" Command="{Binding Download.PopularCommand}" IsVisible="{Binding Download.IsSearchMode}"  AutomationProperties.Name="热门推荐"><icons:IconLabel Icon="StatusInfo" Text="热门推荐" Foreground="{Binding $parent[Button].Foreground}" /></Button></Grid>
        <Grid ColumnDefinitions="*,8,*,8,*" IsVisible="{Binding Download.IsSearchMode}" IsEnabled="{Binding Download.CanEditSearch}">
          <ComboBox ItemsSource="{Binding Download.Sources}" SelectedItem="{Binding Download.SelectedSource}" />
          <TextBox Grid.Column="2" Text="{Binding Download.GameVersionFilter}" PlaceholderText="游戏版本，例如 1.21.4" />
          <ComboBox Grid.Column="4" ItemsSource="{Binding Download.Loaders}" SelectedItem="{Binding Download.LoaderFilter}" IsVisible="{Binding Download.ShowsLoaderFilter}" />
        </Grid>
        <Grid ColumnDefinitions="*,8,*,Auto" IsVisible="{Binding Download.IsSearchMode}" IsEnabled="{Binding Download.CanEditSearch}">
          <ComboBox ItemsSource="{Binding Download.ResourceTags}" SelectedItem="{Binding Download.SelectedTag}" />
          <ComboBox Grid.Column="2" ItemsSource="{Binding Download.SortOptions}" SelectedItem="{Binding Download.SelectedSort}" />
          <Button Grid.Column="3" Classes="quiet" Command="{Binding Download.ResetFiltersCommand}" Margin="8,0,0,0"  AutomationProperties.Name="重置"><icons:IconLabel Icon="ActionRefresh" Text="重置" Foreground="{Binding $parent[Button].Foreground}" /></Button>
        </Grid>
        <TextBlock Text="{Binding Download.TargetText}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <Grid Grid.Row="3">
      <ListBox ItemsSource="{Binding Download.Results}" SelectedItem="{Binding Download.SelectedResult}" IsVisible="{Binding Download.IsSearchMode}">
        <ListBox.ItemTemplate><DataTemplate x:DataType="vm:DownloadItem"><Grid ColumnDefinitions="42,*" Margin="2,6"><Border CornerRadius="10" Width="32" Height="32" Background="{DynamicResource SelectedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="Medium" /><TextBlock Text="{Binding Description}" Classes="muted" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ScrollViewer IsVisible="{Binding Download.IsVersionList}" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
        <TextBlock Text="最新版本" Classes="muted" />
        <ItemsControl ItemsSource="{Binding Download.LatestVersions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VersionItem"><Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding SelectCommand}" CommandParameter="{Binding}" Margin="0,3"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Id}" FontWeight="Medium" /><TextBlock Grid.Column="1" Text="{Binding TypeText}" Classes="muted" Margin="20,0,0,0" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <ItemsControl ItemsSource="{Binding Download.VersionGroups}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VersionGroup"><Expander Header="{Binding Header}" IsExpanded="{Binding IsExpanded}"><ItemsControl ItemsSource="{Binding Versions}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:VersionItem"><Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Command="{Binding SelectCommand}" CommandParameter="{Binding}" Content="{Binding Id}" Margin="0,3" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer>
      <ScrollViewer x:Name="VersionInstallScroll" IsVisible="{Binding Download.IsVersionConfiguration}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="0,0,4,8">
          <Border Classes="card" Padding="18">
            <Grid ColumnDefinitions="Auto,48,*" ColumnSpacing="14">
              <Button x:Name="BackToVersions" Classes="quiet" Command="{Binding Download.BackToVersionsCommand}" Content="‹ 返回" VerticalAlignment="Center" />
              <icons:UiIcon Grid.Column="1" Kind="Tile.LoaderVanilla" Width="42" Height="42" VerticalAlignment="Center" />
              <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="{Binding Download.InstallGameVersion}" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="选择 Mod 加载器" Classes="muted" /></StackPanel>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding Download.CanConfigureVersion}">
            <TextBlock Text="下载源" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button Classes="nav" Classes.active="{Binding Download.IsOfficialSource}" Content="官方" Command="{Binding Download.UseDownloadSourceCommand}" CommandParameter="official" />
            <Button Classes="nav" Classes.active="{Binding Download.IsBmclapiSource}" Content="BMCLAPI 镜像" Command="{Binding Download.UseDownloadSourceCommand}" CommandParameter="bmclapi" />
          </StackPanel>
          <TextBlock Text="安装方式" FontSize="16" FontWeight="SemiBold" />
          <ItemsControl ItemsSource="{Binding Download.InstallLoaders}" IsEnabled="{Binding Download.CanConfigureVersion}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:InstallLoaderChoice">
              <Button Classes="nav" Classes.active="{Binding IsSelected}" Command="{Binding SelectCommand}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}" Width="148" MinHeight="116" Margin="0,0,8,8" HorizontalContentAlignment="Left">
                <StackPanel Spacing="8"><icons:UiIcon Kind="{Binding Icon}" Width="32" Height="32" HorizontalAlignment="Left" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Classes="muted" FontSize="11" /></StackPanel>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="card" Padding="18" IsVisible="{Binding Download.ShowsInstallLoaderVersions}">
            <StackPanel Spacing="12">
              <TextBlock Text="加载器版本" FontWeight="SemiBold" />
              <ComboBox x:Name="InstallLoaderVersion" ItemsSource="{Binding Download.InstallLoaderVersions}" SelectedItem="{Binding Download.SelectedInstallLoaderVersion}" PlaceholderText="请选择加载器版本" IsEnabled="{Binding Download.CanConfigureVersion}" AutomationProperties.Name="加载器版本" />
              <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding Download.IsLoadingLoaderVersions}" />
              <TextBlock Text="{Binding Download.LoaderVersionStatus}" TextWrapping="Wrap" Classes="muted" />
              <Button Classes="quiet" Content="刷新版本列表" Command="{Binding Download.ReloadLoaderVersionsCommand}" IsEnabled="{Binding Download.CanConfigureVersion}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <TextBlock Text="每次选择一种加载器；需要的 Fabric API 等模组可在安装后到「模组」中添加。" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="4" Classes="card" Padding="14" Margin="0,12,0,0"><StackPanel Spacing="10">
      <TextBlock Text="{Binding Download.InstallSummary}" IsVisible="{Binding Download.IsVersionConfiguration}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Download.Status}" Classes="muted" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding Download.IsBusy}" Value="{Binding Download.ProgressPercent}" Maximum="100" Height="4" />
      <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Download.IsSearchMode}"><Button Content="‹" Command="{Binding Download.PreviousPageCommand}" /><TextBlock Text="{Binding Download.PageText}" Classes="muted" VerticalAlignment="Center" /><Button Content="›" Command="{Binding Download.NextPageCommand}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button IsVisible="{Binding Download.CanCancel}" Command="{Binding Download.CancelCommand}"  AutomationProperties.Name="取消"><icons:IconLabel Icon="ActionClose" Text="取消" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Classes="primary" Command="{Binding Download.InstallCommand}" IsVisible="{Binding Download.IsSearchMode}"  AutomationProperties.Name="安装所选资源"><icons:IconLabel Icon="ActionCloudDownload" Text="安装所选资源" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Classes="primary" Command="{Binding Download.InstallVersionCommand}" x:Name="InstallGameVersion" IsVisible="{Binding Download.IsVersionConfiguration}" AutomationProperties.Name="开始安装"><icons:IconLabel Icon="ActionCloudDownload" Text="开始安装" Foreground="{Binding $parent[Button].Foreground}" /></Button></StackPanel></Grid>
    </StackPanel></Border>
  </Grid>
</UserControl>
