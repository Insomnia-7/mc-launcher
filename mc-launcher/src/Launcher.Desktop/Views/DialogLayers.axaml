<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="using:Avalonia.Data.Converters" xmlns:motion="using:Launcher.Desktop" xmlns:vm="using:Launcher.App.ViewModels" xmlns:versions="using:Launcher.Domain.Versions" x:DataType="vm:MainViewModel" xmlns:icons="using:Launcher.Desktop.Controls" xmlns:views="using:Launcher.Desktop.Views" x:Class="Launcher.Desktop.Views.DialogLayers" IsHitTestVisible="{Binding HasOverlay}">
  <Grid>
    <Grid Classes="modal" motion:Motion.IsOpen="{Binding IsSetupOpen}">
      <Border Classes="modal-surface" Width="560" MaxHeight="620"><ScrollViewer><StackPanel Spacing="15">
        <TextBlock Text="开始你的 Minecraft" Classes="heading" /><TextBlock Text="选好版本与身份，其余交给启动器。" Classes="muted" />
        <StackPanel Spacing="7" IsEnabled="{Binding CanEditSetup}"><TextBlock Text="游戏版本" /><ComboBox ItemsSource="{Binding SetupVersions}" SelectedItem="{Binding SetupVersion}"><ComboBox.ItemTemplate><DataTemplate x:DataType="versions:ManifestEntry"><TextBlock Text="{Binding Id}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Command="{Binding ReloadSetupVersionsCommand}" HorizontalAlignment="Left" Classes="quiet"  AutomationProperties.Name="刷新版本列表"><icons:IconLabel Icon="ActionRefresh" Text="刷新版本列表" Foreground="{Binding $parent[Button].Foreground}" /></Button></StackPanel>
        <Grid ColumnDefinitions="*,14,*" IsEnabled="{Binding CanEditSetup}"><StackPanel Spacing="7"><TextBlock Text="内存（MB）" /><TextBox Text="{Binding SetupMemoryText}" /></StackPanel><StackPanel Grid.Column="2" Spacing="7"><TextBlock Text="离线用户名" /><TextBox Text="{Binding SetupOfflineName}" IsReadOnly="{Binding HasAccount}" /></StackPanel></Grid>
        <TextBlock Text="{Binding SetupIdentityText}" Classes="muted" TextWrapping="Wrap" /><Button Command="{Binding OpenAccountsCommand}" HorizontalAlignment="Left"  AutomationProperties.Name="选择 / 添加账号"><icons:IconLabel Icon="ActionLogin" Text="选择 / 添加账号" Foreground="{Binding $parent[Button].Foreground}" /></Button>
        <CheckBox Content="安装完成后启动游戏" IsChecked="{Binding SetupLaunchAfterInstall}" />
        <TextBlock Text="{Binding SetupError}" Classes="optional" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding SetupStatus}" Classes="muted" TextWrapping="Wrap" /><ProgressBar IsVisible="{Binding IsSetupBusy}" Value="{Binding ProgressPercent}" Height="4" />
        <WrapPanel><Button Command="{Binding ChooseGameRootCommand}" Margin="0,0,8,8"  AutomationProperties.Name="选择游戏目录"><icons:IconLabel Icon="ActionFolder" Text="选择游戏目录" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Command="{Binding OpenNetworkCommand}" Margin="0,0,8,8"  AutomationProperties.Name="网络设置"><icons:IconLabel Icon="ActionGlobe" Text="网络设置" Foreground="{Binding $parent[Button].Foreground}" /></Button></WrapPanel>
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><Button Content="稍后设置" Command="{Binding CloseSetupCommand}" HorizontalAlignment="Left" /><Button Grid.Column="1" Command="{Binding CancelCommand}" IsVisible="{Binding IsSetupBusy}"  AutomationProperties.Name="取消"><icons:IconLabel Icon="ActionClose" Text="取消" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button x:Name="InstallSetupButton" Grid.Column="2" Classes="primary" Command="{Binding InstallSetupCommand}"  AutomationProperties.Name="一键安装"><icons:IconLabel Icon="ActionCloudDownload" Text="一键安装" Foreground="{Binding $parent[Button].Foreground}" /></Button></Grid>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Grid Classes="modal" motion:Motion.IsOpen="{Binding IsAccountsOpen}">
      <Border Classes="modal-surface" Width="580" MaxHeight="620"><ScrollViewer><StackPanel Spacing="16">
        <TextBlock Text="游戏身份" Classes="heading" /><TextBlock Text="选择一个身份，用于下一次出发。" Classes="muted" />
        <ListBox ItemsSource="{Binding AccountChoices}" SelectedItem="{Binding SelectedAccountChoice}" IsEnabled="{Binding CanManageAccounts}" MaxHeight="220" AutomationProperties.Name="已保存的游戏身份"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:AccountChoice"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="Medium" /><TextBlock Text="{Binding Detail}" Classes="muted" /></StackPanel><TextBlock Grid.Column="1" Text="使用中" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" Margin="12,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        <StackPanel Spacing="7"><TextBlock Text="离线用户名" Classes="muted" /><TextBox Text="{Binding OfflineName, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanManageAccounts}" /></StackPanel>
        <TextBlock Text="{Binding AccountHint}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{Binding LoginCode}" IsVisible="{Binding IsLoggingIn}" FontSize="24" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding LoginHint}" IsVisible="{Binding IsLoggingIn}" Classes="muted" TextWrapping="Wrap" />
        <WrapPanel><Button Classes="primary" Command="{Binding UseAccountCommand}" Margin="0,0,8,8"  AutomationProperties.Name="使用此身份"><icons:IconLabel Icon="ActionCheck" Text="使用此身份" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Command="{Binding LoginCommand}" Margin="0,0,8,8"  AutomationProperties.Name="添加微软账号"><icons:IconLabel Icon="ActionLogin" Text="添加微软账号" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Classes="danger" Command="{Binding RemoveAccountCommand}" Margin="0,0,8,8"  AutomationProperties.Name="移除账号"><icons:IconLabel Icon="ActionDelete" Text="移除账号" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Command="{Binding LoginCancelCommand}" IsVisible="{Binding IsLoggingIn}" Margin="0,0,8,8"  AutomationProperties.Name="取消登录"><icons:IconLabel Icon="ActionClose" Text="取消登录" Foreground="{Binding $parent[Button].Foreground}" /></Button></WrapPanel>
        <Button Command="{Binding OpenWardrobeCommand}" Content="角色衣柜 · 皮肤与披风" HorizontalAlignment="Left" />
        <Button Command="{Binding CloseAccountsCommand}" HorizontalAlignment="Right"  AutomationProperties.Name="完成"><icons:IconLabel Icon="ActionCheck" Text="完成" Foreground="{Binding $parent[Button].Foreground}" /></Button>
      </StackPanel></ScrollViewer></Border>
    </Grid>
    <Grid Classes="modal" motion:Motion.IsOpen="{Binding IsPreferencesOpen}">
      <Border x:Name="PreferencesSurface" Classes="modal-surface" Width="620" MaxHeight="620" Padding="24">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="18">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="设置" Classes="heading" /><TextBlock Text="调好外观，畅快连接。" Classes="muted" /></StackPanel><Button Classes="quiet" Command="{Binding CloseTopOverlayCommand}" Width="32" Height="32" MinHeight="32" Padding="7" HorizontalContentAlignment="Center" VerticalAlignment="Top" ToolTip.Tip="关闭设置" AutomationProperties.Name="关闭设置"><icons:UiIcon Kind="ActionClose" Foreground="{Binding $parent[Button].Foreground}" /></Button></Grid>
          <Border Grid.Row="1" Background="{DynamicResource FieldBrush}" CornerRadius="12" Padding="4">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="4"><Button x:Name="AppearanceSettingsTab" Classes="nav" Classes.active="{Binding IsAppearanceOpen}" Command="{Binding OpenAppearanceCommand}" HorizontalContentAlignment="Center" AutomationProperties.Name="外观"><icons:IconLabel Icon="ActionSettings" Text="外观" /></Button><Button x:Name="NetworkSettingsTab" Grid.Column="1" Classes="nav" Classes.active="{Binding IsNetworkOpen}" Command="{Binding OpenNetworkCommand}" HorizontalContentAlignment="Center" AutomationProperties.Name="网络"><icons:IconLabel Icon="ActionGlobe" Text="网络" /></Button></Grid>
          </Border>
          <ScrollViewer Grid.Row="2" IsVisible="{Binding IsAppearanceOpen}" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
        <ListBox x:Name="ThemeList" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" MaxHeight="230"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ThemeChoice"><StackPanel Width="128" Spacing="8"><Border CornerRadius="12" Height="46" Background="{Binding Swatch}" BorderBrush="{Binding Accent}" BorderThickness="1"><Border Width="28" Height="6" CornerRadius="3" Background="{Binding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
        <Grid ColumnDefinitions="*,12,*"><Button Command="{Binding ImportWallpaperCommand}"  AutomationProperties.Name="导入壁纸"><icons:IconLabel Icon="ActionImport" Text="导入壁纸" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Grid.Column="2" Command="{Binding RemoveWallpaperCommand}"  AutomationProperties.Name="恢复主题背景"><icons:IconLabel Icon="ActionRefresh" Text="恢复主题背景" Foreground="{Binding $parent[Button].Foreground}" /></Button></Grid>
        <StackPanel Spacing="6"><TextBlock Text="壁纸显示强度" Classes="muted" /><Slider Value="{Binding WallpaperOpacity}" Minimum="0" Maximum="0.85" IsEnabled="{Binding CanEditAppearance}" /></StackPanel>
        <StackPanel Spacing="7"><TextBlock Text="动画" Classes="muted" /><ComboBox x:Name="MotionChoice" ItemsSource="{Binding MotionChoices}" SelectedItem="{Binding SelectedMotion}" /></StackPanel>
        <TextBlock Text="{Binding AppearanceHint}" Classes="muted" TextWrapping="Wrap" /><Button Command="{Binding CloseAppearanceCommand}" HorizontalAlignment="Right" Classes="primary"  AutomationProperties.Name="完成"><icons:IconLabel Icon="ActionCheck" Text="完成" Foreground="{Binding $parent[Button].Foreground}" /></Button>
          </StackPanel></ScrollViewer>
          <ScrollViewer Grid.Row="2" IsVisible="{Binding IsNetworkOpen}" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
            <TextBlock Text="连接方式" FontWeight="SemiBold" /><TextBlock Text="{Binding ActiveNetworkText}" Classes="muted" TextWrapping="Wrap" />
        <ComboBox ItemsSource="{Binding ProxyModes}" SelectedIndex="{Binding ProxyModeIndex}" /><TextBox Text="{Binding ProxyAddress}" PlaceholderText="http://127.0.0.1:7890" IsVisible="{Binding IsCustomProxy}" />
        <TextBlock Text="{Binding NetworkHint}" Classes="muted" TextWrapping="Wrap" /><Grid ColumnDefinitions="*,Auto"><Button Command="{Binding CloseNetworkCommand}" HorizontalAlignment="Left"  AutomationProperties.Name="取消"><icons:IconLabel Icon="ActionClose" Text="取消" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Grid.Column="1" Classes="primary" Command="{Binding SaveNetworkCommand}"  AutomationProperties.Name="保存"><icons:IconLabel Icon="ActionCheck" Text="保存" Foreground="{Binding $parent[Button].Foreground}" /></Button></Grid>
          </StackPanel></ScrollViewer>
        </Grid>
      </Border>
    </Grid>
    <views:ExperienceView />
    <Grid Classes="modal" ZIndex="50" motion:Motion.IsOpen="{Binding IsConfirmOpen}">
      <Border Classes="modal-surface" Width="540"><StackPanel Spacing="16">
        <TextBlock Text="{Binding ConfirmTitle}" Classes="heading" TextWrapping="Wrap" /><TextBlock Text="{Binding ConfirmMessage}" TextWrapping="Wrap" /><TextBlock Text="{Binding ConfirmDetail}" Classes="muted" IsVisible="{Binding HasConfirmDetail}" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,Auto"><Button Command="{Binding ConfirmCancelCommand}" IsVisible="{Binding ConfirmShowCancel}" HorizontalAlignment="Left"  AutomationProperties.Name="取消"><icons:IconLabel Icon="ActionClose" Text="取消" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Grid.Column="1" Content="{Binding ConfirmOkText}" Command="{Binding ConfirmOkCommand}" Classes="primary" /></Grid>
      </StackPanel></Border>
    </Grid>
  </Grid>
</UserControl>
