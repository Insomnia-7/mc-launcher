<UserControl xmlns="https://github.com/avaloniaui" xmlns:icons="using:Launcher.Desktop.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.Views.DialogLayers" xmlns:vm="using:Launcher.App.ViewModels" xmlns:conv="using:Avalonia.Data.Converters" xmlns:views="using:Launcher.Desktop.Views" xmlns:versions="using:Launcher.Domain.Versions" xmlns:accounts="using:Launcher.Application.Accounts" xmlns:experience="using:Launcher.Application.Experience">
  <Grid>
    <icons:AnimatedDialog x:Name="AccountsDialog" Classes="modal" IsOpen="{Binding IsAccountsOpen}">
      <Border Classes="modal-surface" Width="580" MaxHeight="540" Padding="28">
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="20">
          <StackPanel Spacing="6">
            <TextBlock Text="账号与角色" Classes="heading" />
            <TextBlock Text="选择用于启动 Minecraft 的账号。" Classes="muted" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16">
              <ListBox ItemsSource="{Binding AccountChoices}" SelectedItem="{Binding SelectedAccountChoice}" IsEnabled="{Binding CanManageAccounts}" MaxHeight="220" AutomationProperties.Name="已保存的游戏身份">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AccountChoice">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="5">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                        <TextBlock Text="{Binding Detail}" Classes="muted" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="使用中" Foreground="{DynamicResource AccentBrush}" IsVisible="{Binding IsCurrent}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Spacing="7">
                <TextBlock Text="离线用户名" Classes="muted" />
                <TextBox x:Name="OfflineNameInput" Text="{Binding OfflineName, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding CanManageAccounts}" AutomationProperties.Name="离线用户名" />
              </StackPanel>
              <TextBlock Text="{Binding AccountHint}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding LoginCode}" IsVisible="{Binding IsLoggingIn}" FontSize="24" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding LoginHint}" IsVisible="{Binding IsLoggingIn}" Classes="muted" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Command="{Binding LoginCommand}" Margin="0,0,8,8" AutomationProperties.Name="添加微软账号">
                  <icons:IconLabel Icon="ActionLogin" Text="添加微软账号" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button Classes="danger" Command="{Binding RemoveAccountCommand}" Margin="0,0,8,8" AutomationProperties.Name="移除账号">
                  <icons:IconLabel Icon="ActionDelete" Text="移除账号" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button Command="{Binding LoginCancelCommand}" IsVisible="{Binding IsLoggingIn}" Margin="0,0,8,8" AutomationProperties.Name="取消登录">
                  <icons:IconLabel Icon="ActionClose" Text="取消登录" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
              </WrapPanel>
              <Button Command="{Binding OpenWardrobeCommand}" Content="角色衣柜 · 皮肤与披风" HorizontalAlignment="Left" />
            </StackPanel>
          </ScrollViewer>
          <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button Classes="primary" Command="{Binding UseAccountCommand}" Margin="0" AutomationProperties.Name="使用此身份" HorizontalAlignment="Left">
              <icons:IconLabel Icon="ActionCheck" Text="使用此身份" Foreground="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button Command="{Binding CloseAccountsCommand}" HorizontalAlignment="Right" AutomationProperties.Name="完成" Grid.Column="1">
              <icons:IconLabel Icon="ActionCheck" Text="完成" Foreground="{Binding $parent[Button].Foreground}" />
            </Button>
          </Grid>
        </Grid>
      </Border>
    </icons:AnimatedDialog>
    <icons:AnimatedDialog x:Name="ConfirmDialog" Classes="modal" ZIndex="50" IsOpen="{Binding IsConfirmOpen}">
      <Border Classes="modal-surface" Width="540">
        <StackPanel Spacing="16">
          <TextBlock Text="{Binding ConfirmTitle}" Classes="heading" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConfirmMessage}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ConfirmDetail}" Classes="muted" IsVisible="{Binding HasConfirmDetail}" TextWrapping="Wrap" />
          <CheckBox IsVisible="{Binding ConfirmOffersJavaCleanup}" IsChecked="{Binding ConfirmDeleteManagedJava}" AutomationProperties.Name="同时删除自动下载的 Java"><TextBlock Text="{Binding ConfirmJavaCleanupText}" TextWrapping="Wrap"/></CheckBox>
          <Grid ColumnDefinitions="*,Auto">
            <Button Command="{Binding ConfirmCancelCommand}" IsVisible="{Binding ConfirmShowCancel}" HorizontalAlignment="Left" AutomationProperties.Name="取消">
              <icons:IconLabel Icon="ActionClose" Text="取消" Foreground="{Binding $parent[Button].Foreground}" />
            </Button>
            <Button Grid.Column="1" Content="{Binding ConfirmOkText}" Command="{Binding ConfirmOkCommand}" Classes="primary" Classes.danger-solid="{Binding ConfirmIsDanger}" />
          </Grid>
        </StackPanel>
      </Border>
    </icons:AnimatedDialog>
    <icons:AnimatedDialog x:Name="RestartDialog" Classes="modal" IsOpen="{Binding DataRestartRequired}">
      <Border Classes="modal-surface" Width="560">
        <StackPanel Spacing="18">
          <TextBlock Text="数据已迁移，请重新打开方隅" Classes="heading" />
          <TextBlock Text="{Binding DataMoveHint}" TextWrapping="Wrap" />
          <Button Classes="primary" Command="{Binding RestartForDataMoveCommand}" Content="退出方隅（请重新打开）" />
        </StackPanel>
      </Border>
    </icons:AnimatedDialog>
  </Grid>
</UserControl>
