<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Launcher.App.ViewModels" xmlns:motion="using:Launcher.Desktop" xmlns:icons="using:Launcher.Desktop.Controls" xmlns:accounts="using:Launcher.Application.Accounts" xmlns:experience="using:Launcher.Application.Experience" xmlns:operations="using:Launcher.Application.Operations" x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.Views.ExperienceView" IsHitTestVisible="{Binding IsExperienceOpen}">
  <Grid Classes="modal" motion:Motion.IsOpen="{Binding IsExperienceOpen}">
    <Border Classes="modal-surface" Width="850" Height="580" MaxWidth="{Binding $parent[Window].Bounds.Width}" Padding="24">
      <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock Text="方隅 · 玩家中心" Classes="heading" /><TextBlock Text="{Binding AppearanceIdentity}" Classes="muted" /></StackPanel><Button Grid.Column="1" x:Name="CloseExperienceButton" Classes="quiet" Command="{Binding CloseExperienceCommand}" Width="34" Padding="7" AutomationProperties.Name="关闭玩家中心"><icons:UiIcon Kind="ActionClose" /></Button></Grid>
        <Border Grid.Row="1" Background="{DynamicResource FieldBrush}" CornerRadius="12" Padding="4"><Grid ColumnDefinitions="*,*,*" ColumnSpacing="5">
          <Button x:Name="WardrobeTab" Classes="nav" Classes.active="{Binding IsWardrobeTab}" Command="{Binding SelectExperienceTabCommand}" CommandParameter="0" Content="角色衣柜" HorizontalContentAlignment="Center" />
          <Button Grid.Column="1" x:Name="InstanceHistoryTab" Classes="nav" Classes.active="{Binding IsHistoryTab}" Command="{Binding SelectExperienceTabCommand}" CommandParameter="1" Content="实例历史与预设" HorizontalContentAlignment="Center" />
          <Button Grid.Column="2" x:Name="TaskToolsTab" Classes="nav" Classes.active="{Binding IsToolsTab}" Command="{Binding SelectExperienceTabCommand}" CommandParameter="2" Content="任务与体检" HorizontalContentAlignment="Center" />
        </Grid></Border>
        <ScrollViewer Grid.Row="2" IsVisible="{Binding IsWardrobeTab}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="160,220,*" ColumnSpacing="14" IsEnabled="{Binding CanEditWardrobe}">
              <StackPanel Spacing="9"><TextBlock Text="当前身份" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding AccountChoices}" SelectedItem="{Binding SelectedAccountChoice}" AutomationProperties.Name="衣柜账号"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:AccountChoice"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Command="{Binding UseAccountCommand}" Content="使用此身份" /><TextBlock Text="本地方案" FontWeight="SemiBold" Margin="0,8,0,0" /><ListBox x:Name="WardrobeLooksList" ItemsSource="{Binding WardrobeLooks}" SelectedItem="{Binding SelectedLook}" MinHeight="140" MaxHeight="205"><ListBox.ItemTemplate><DataTemplate x:DataType="accounts:WardrobeLook"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate></ListBox><Button Classes="quiet" Command="{Binding DeleteWardrobeLookCommand}" Content="移除本地方案" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="8"><Border Background="{DynamicResource FieldBrush}" CornerRadius="18" Padding="8"><icons:PlayerPreview x:Name="WardrobePlayerPreview" Skin="{Binding PreviewSkin}" Cape="{Binding PreviewCape}" Slim="{Binding PreviewSlim}" OuterLayer="{Binding PreviewOuterLayer}" Height="240" AutomationProperties.Name="拖动或使用方向键旋转角色预览" /></Border><TextBlock Text="拖动旋转 · 方向键可用" HorizontalAlignment="Center" Classes="muted" FontSize="12" /><CheckBox Content="细手臂（Alex）" IsChecked="{Binding PreviewSlim}" /><CheckBox Content="显示皮肤外层" IsChecked="{Binding PreviewOuterLayer}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="9"><TextBlock Text="皮肤与披风" FontWeight="SemiBold" /><TextBox Text="{Binding LookName}" PlaceholderText="给皮肤方案命名" /><Button x:Name="ImportWardrobeSkinButton" Command="{Binding ImportWardrobeSkinCommand}" Content="导入 PNG 皮肤" />
                <StackPanel Spacing="8" IsVisible="{Binding HasAccount}"><Button x:Name="UploadSkinButton" Classes="primary" Command="{Binding UploadWardrobeSkinCommand}" ><TextBlock Text="上传到当前账号" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Command="{Binding ResetOfficialSkinCommand}" Content="恢复官方默认皮肤" /><TextBlock Text="账号已拥有的披风" Classes="muted" /><ComboBox ItemsSource="{Binding OwnedCapes}" SelectedItem="{Binding SelectedOwnedCape}"><ComboBox.ItemTemplate><DataTemplate x:DataType="accounts:OwnedCape"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><WrapPanel><Button Command="{Binding ApplyOwnedCapeCommand}" Content="使用披风" Margin="0,0,6,6" /><Button Command="{Binding HideOfficialCapeCommand}" Content="隐藏披风" Margin="0,0,0,6" /></WrapPanel></StackPanel>
                <StackPanel Spacing="8" IsVisible="{Binding !HasAccount}"><Button Command="{Binding ImportWardrobeCapeCommand}" Content="导入本地披风" /><Button Command="{Binding InstallOfflineSkinComponentCommand}" Content="安装离线皮肤组件" /><Button Classes="primary" Command="{Binding UseLocalLookCommand}" ><TextBlock Text="应用本地外观" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Classes="quiet" Command="{Binding DisableLocalLookCommand}" Content="停用游戏内本地外观" /></StackPanel>
                <Button Classes="quiet" Command="{Binding RefreshWardrobeCommand}" Content="刷新官方资料" IsVisible="{Binding HasAccount}" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding LocalSkinHint}" Classes="muted" TextWrapping="Wrap" /><TextBlock x:Name="WardrobeStatus" Text="{Binding WardrobeHint}" TextWrapping="Wrap" /><ProgressBar IsVisible="{Binding WardrobeBusy}" IsIndeterminate="True" Height="3" />
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Grid.Row="2" IsVisible="{Binding IsHistoryTab}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"><StackPanel Spacing="18">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="18" IsEnabled="{Binding CanEditExperience}">
            <StackPanel Spacing="10"><TextBlock Text="实例快照" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="模组与配置可单独回退，默认保留当前存档。" Classes="muted" TextWrapping="Wrap" /><TextBox Text="{Binding SnapshotName}" /><CheckBox Content="同时备份存档" IsChecked="{Binding IncludeWorlds}" /><Button x:Name="CreateSnapshotButton" Command="{Binding CreateSnapshotCommand}" Content="为当前实例创建快照" /><ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" MaxHeight="145"><ListBox.ItemTemplate><DataTemplate x:DataType="experience:InstanceSnapshot"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding Summary}" FontSize="12" Classes="muted" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><ComboBox ItemsSource="{Binding RestoreScopes}" SelectedIndex="{Binding RestoreScope}" /><WrapPanel><Button x:Name="RestoreSnapshotButton" Command="{Binding RestoreSnapshotCommand}" Content="恢复选中快照…" Margin="0,0,6,6" /><Button Command="{Binding DeleteSnapshotCommand}" Content="删除快照…" Classes="quiet" Margin="0,0,0,6" /></WrapPanel></StackPanel>
            <StackPanel Grid.Column="1" Spacing="10"><TextBlock Text="设置预设" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="保存内存、窗口、画质、音量与按键设置；应用前自动备份。" Classes="muted" TextWrapping="Wrap" /><TextBox Text="{Binding PresetName}" /><CheckBox Content="包含模组配置（需相同游戏版本与加载器）" IsChecked="{Binding IncludeModConfigs}" /><Button Command="{Binding SavePresetCommand}" Content="保存当前实例为预设" /><ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" /><WrapPanel><Button x:Name="ApplyPresetButton" Command="{Binding ApplyPresetCommand}" Classes="primary" Margin="0,0,6,6"><TextBlock Text="应用选中预设" Foreground="{Binding $parent[Button].Foreground}" /></Button><Button Command="{Binding DeletePresetCommand}" Content="移除预设" Classes="quiet" Margin="0,0,0,6" /></WrapPanel><TextBlock Text="不复制账号和 Java 路径；新旧格式不兼容的按键会跳过。" Classes="muted" TextWrapping="Wrap" /></StackPanel>
          </Grid>
          <Border Height="1" Background="{DynamicResource LineBrush}" />
          <StackPanel Spacing="10"><TextBlock Text="模组更新策略" FontSize="18" FontWeight="SemiBold" /><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><ComboBox ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" /><Button Grid.Column="1" Command="{Binding CheckModUpdatesCommand}" Content="检查兼容更新" IsEnabled="{Binding CanEditExperience}" /></Grid><ItemsControl ItemsSource="{Binding ModUpdates}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MainViewModel+ModUpdateRow"><Border Classes="card" Padding="10" Margin="0,0,0,6"><StackPanel Spacing="7"><TextBlock Text="{Binding Title}" /><TextBlock Text="{Binding VersionText}" Classes="muted" /><WrapPanel><Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UpdateModCommand}" CommandParameter="{Binding}" Content="更新前备份并安装…" Margin="0,0,5,5" /><Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).SkipModUpdateCommand}" CommandParameter="{Binding}" Content="跳过此版" Margin="0,0,5,5" /><Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).LockModUpdateCommand}" CommandParameter="{Binding}" Content="锁定当前版本" Margin="0,0,0,5" /></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><ItemsControl ItemsSource="{Binding LockedModFiles}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String"><Grid ColumnDefinitions="*,Auto" Margin="0,4"><TextBlock Text="{Binding}" VerticalAlignment="Center" /><Button Grid.Column="1" Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).UnlockModUpdateCommand}" CommandParameter="{Binding}" Content="解除版本锁定" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
        </StackPanel></ScrollViewer>
        <ScrollViewer Grid.Row="2" IsVisible="{Binding IsToolsTab}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"><StackPanel Spacing="16">
          <TextBlock Text="任务中心" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="暂停保留断点；恢复沿用安装参数。取消会清理未完成文件。关闭程序时会保存正在运行的任务。" Classes="muted" TextWrapping="Wrap" />
          <ItemsControl x:Name="DurableTasksList" ItemsSource="{Binding DurableTasks}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DurableTaskRow"><Border Classes="card" Padding="12" Margin="0,0,0,8"><StackPanel Spacing="7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="muted" /></Grid><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" /><ProgressBar Value="{Binding Percent}" Height="3" /><WrapPanel><Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ResumeDurableTaskCommand}" CommandParameter="{Binding}" Content="开始 / 恢复 / 重试" IsEnabled="{Binding CanResume}" Margin="0,0,6,0" /><Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PauseDurableTaskCommand}" CommandParameter="{Binding}" Content="暂停" IsEnabled="{Binding CanPause}" Margin="0,0,6,0" /><Button Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CancelDurableTaskCommand}" CommandParameter="{Binding}" Content="取消并清理" IsEnabled="{Binding CanCancel}" /></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Border Height="1" Background="{DynamicResource LineBrush}" /><TextBlock Text="启动体检与诊断" FontSize="18" FontWeight="SemiBold" /><WrapPanel><Button x:Name="InspectInstanceButton" Command="{Binding InspectInstanceCommand}" Content="检查当前实例" IsEnabled="{Binding CanEditExperience}" Margin="0,0,8,0" /><Button Command="{Binding ExportDiagnosticsCommand}" Content="导出脱敏诊断包" IsEnabled="{Binding CanEditExperience}" /></WrapPanel>
          <ItemsControl ItemsSource="{Binding InspectionIssues}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="experience:InspectionIssue"><Border Classes="card" Padding="12" Margin="0,0,0,7"><StackPanel Spacing="5"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Evidence}" Classes="muted" TextWrapping="Wrap" /><TextBlock Text="{Binding Advice}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="7"><ProgressBar IsVisible="{Binding ExperienceBusy}" IsIndeterminate="True" Height="3" /><TextBlock Text="{Binding ExperienceHint}" Classes="optional" FontSize="12" TextWrapping="Wrap" MaxHeight="50" TextTrimming="CharacterEllipsis" /></StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
