<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Launcher.App.ViewModels" xmlns:icons="using:Launcher.Desktop.Controls" xmlns:accounts="using:Launcher.Application.Accounts" xmlns:experience="using:Launcher.Application.Experience" xmlns:conv="using:Avalonia.Data.Converters" xmlns:views="using:Launcher.Desktop.Views" x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.Views.InstanceSettingsView">
  <Grid RowDefinitions="*,Auto" RowSpacing="16">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="24">
      <StackPanel Spacing="8"><TextBlock Text="运行设置" Classes="section-title"/><TextBlock Text="为当前 Minecraft 实例选择合适的运行环境。" Classes="muted" TextWrapping="Wrap"/></StackPanel>
      <Border Classes="card"><StackPanel Spacing="18"><views:MemoryAllocationView/><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Java 运行环境" VerticalAlignment="Center"/><Button Grid.Column="1" Classes="link" Command="{Binding DetectLocalJavaCommand}" Content="重新检测"/></Grid><ComboBox ItemsSource="{Binding JavaOptions}" SelectedItem="{Binding SelectedJava}" HorizontalAlignment="Stretch"/></StackPanel></StackPanel></Border>
      <Expander Header="高级启动参数" HorizontalAlignment="Stretch"><StackPanel Spacing="16" Margin="0,12"><StackPanel Spacing="6"><TextBlock Text="JVM 策略" Classes="label"/><ComboBox SelectedIndex="{Binding JvmPresetIndex}" HorizontalAlignment="Stretch"><ComboBoxItem Content="默认"/><ComboBoxItem Content="快速"/><ComboBoxItem Content="兼容"/></ComboBox></StackPanel><TextBox Text="{Binding ExtraJvmArgs}" PlaceholderText="额外 JVM 参数（可选）"/><TextBox Text="{Binding ExtraGameArgs}" PlaceholderText="额外游戏参数（可选）"/><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock Text="窗口宽度" Classes="label"/><NumericUpDown Value="{Binding WindowWidth}" Minimum="320" Maximum="7680" FormatString="0"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="窗口高度" Classes="label"/><NumericUpDown Value="{Binding WindowHeight}" Minimum="240" Maximum="4320" FormatString="0"/></StackPanel></Grid></StackPanel></Expander>
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock Text="共享游戏设置" FontWeight="Medium"/><TextBlock Text="管理多个 Minecraft 实例之间的按键与音量同步。" Classes="label" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Command="{Binding OpenSettingsSyncCommand}" Content="管理同步" VerticalAlignment="Center"/></Grid>
    </StackPanel></ScrollViewer>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding SettingsHint}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/><Button x:Name="SaveSettingsButton" Grid.Column="1" Classes="primary" Command="{Binding SaveSettingsCommand}" Content="保存设置" AutomationProperties.Name="保存设置"/></Grid>
  </Grid>
</UserControl>
