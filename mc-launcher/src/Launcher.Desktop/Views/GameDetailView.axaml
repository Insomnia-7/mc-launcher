<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Launcher.App.ViewModels" xmlns:icons="using:Launcher.Desktop.Controls" xmlns:local="using:Launcher.Desktop" x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.Views.GameDetailView">
  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="24">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Spacing="10"><Button x:Name="BackToLibraryButton" Classes="link" Command="{Binding ShowInstancesCommand}" Content="‹ 实例" HorizontalAlignment="Left" Padding="0"/><TextBlock x:Name="GameDetailTitle" Text="{Binding SelectedGameName}" Classes="page-title" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SelectedGameMeta}" Classes="muted"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom"><Button x:Name="DetailLaunchButton" Classes="primary" Command="{Binding LaunchCommand}" Height="44"><icons:IconLabel Icon="ActionPlay" Text="{Binding LaunchTitle}" Foreground="{Binding $parent[Button].Foreground}"/></Button><Button x:Name="GameMoreButton" Content="···" ToolTip.Tip="实例操作"><Button.Flyout><MenuFlyout><MenuItem Header="打开游戏目录" Command="{Binding OpenGameDirectoryCommand}"/><MenuItem Header="导出备份" Command="{Binding ExportInstanceCommand}"/><MenuItem Header="创建试装副本" Command="{Binding OpenCloneEditorCommand}"/><Separator/><MenuItem Header="删除实例…" Command="{Binding DeleteInstanceCommand}"/></MenuFlyout></Button.Flyout></Button></StackPanel>
    </Grid>
    <Grid x:Name="DetailBody" Grid.Row="1" ColumnDefinitions="148,*" ColumnSpacing="24">
      <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="0,0,12,0"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">    <StackPanel Spacing="4">
      <Button x:Name="PackDetailTab" IsVisible="{Binding IsModpackSelection}" Classes="nav" Classes.active="{Binding IsPackDetailTab}" Command="{Binding SelectDetailTabCommand}" CommandParameter="5" Content="整合包更新" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
      <Button x:Name="OverviewDetailTab" Classes="nav" Classes.active="{Binding IsOverviewTab}" Command="{Binding SelectDetailTabCommand}" CommandParameter="0" Content="概览" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
      <Button x:Name="ModsDetailTab" Classes="nav" Classes.active="{Binding IsModsDetailTab}" Command="{Binding SelectDetailTabCommand}" CommandParameter="1" Content="模组与资源" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
      <Button x:Name="BackupsDetailTab" Classes="nav" Classes.active="{Binding IsBackupsDetailTab}" Command="{Binding SelectDetailTabCommand}" CommandParameter="2" Content="存档与备份" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
      <Button x:Name="SettingsDetailTab" Classes="nav" Classes.active="{Binding IsSettingsDetailTab}" Command="{Binding SelectDetailTabCommand}" CommandParameter="3" Content="设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
      <Button x:Name="DiagnosticsDetailTab" Classes="nav" Classes.active="{Binding IsDiagnosticsDetailTab}" Command="{Binding SelectDetailTabCommand}" CommandParameter="4" Content="日志与诊断" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
</StackPanel></ScrollViewer></Border>
      <Grid Grid.Column="1">
        <ScrollViewer IsVisible="{Binding IsOverviewTab}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="20">
        <Border x:Name="CloneEditor" Classes="card" IsVisible="{Binding IsCloneEditorOpen}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="创建独立试装副本" FontSize="20" FontWeight="SemiBold"/>
              <Button Grid.Column="1" Classes="quiet" Command="{Binding CloseCloneEditorCommand}" Content="收起"/>
            </Grid>
            <TextBlock Text="沿用相同的 Minecraft 与加载器版本，复制的配置和文件彼此独立。" Classes="muted" TextWrapping="Wrap"/>
            <TextBox Text="{Binding CloneName}" MaxLength="80" PlaceholderText="副本名称"/>
            <WrapPanel IsEnabled="{Binding CanUseModWorkbench}">
              <CheckBox Content="模组" IsChecked="{Binding CloneMods}" Margin="0,0,18,8"/>
              <CheckBox Content="设置与配置" IsChecked="{Binding CloneSettings}" Margin="0,0,18,8"/>
              <CheckBox Content="资源包" IsChecked="{Binding CloneResourcePacks}" Margin="0,0,18,8"/>
              <CheckBox Content="光影" IsChecked="{Binding CloneShaderPacks}" Margin="0,0,18,8"/>
              <CheckBox Content="存档" IsChecked="{Binding CloneWorlds}" Margin="0,0,18,8"/>
              <CheckBox Content="截图" IsChecked="{Binding CloneScreenshots}" Margin="0,0,18,8"/>
              <CheckBox Content="服务器列表" IsChecked="{Binding CloneServers}" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="存档默认不复制。副本校验成功后才加入游戏库；复制可在下载任务中暂停或取消。" Classes="muted" TextWrapping="Wrap"/>
            <Button x:Name="CreateTrialCloneButton" Classes="primary" Command="{Binding CreateTrialCloneCommand}" IsEnabled="{Binding CanUseModWorkbench}" HorizontalAlignment="Left">
              <TextBlock Text="开始创建副本" Foreground="{Binding $parent[Button].Foreground}"/>
            </Button>
          </StackPanel>
        </Border>

          <Border Classes="card"><Grid x:Name="InstancePresentationLayout" ColumnDefinitions="*,180" ColumnSpacing="24">
            <StackPanel Spacing="16"><TextBlock Text="实例信息" Classes="section-title"/><TextBlock Text="{Binding SelectedGameStatus}" Classes="label"/><StackPanel Spacing="6"><TextBlock Text="显示名称" Classes="label"/><TextBox x:Name="GameNameInput" Text="{Binding GameDisplayName}" PlaceholderText="留空使用默认名称" MaxLength="80"/></StackPanel><StackPanel Spacing="6"><TextBlock Text="分组" Classes="label"/><TextBox Text="{Binding GameGroupName}" PlaceholderText="例如：生存、建筑" MaxLength="32"/></StackPanel><Button x:Name="SaveInstancePresentationButton" Classes="primary" Command="{Binding SaveGamePresentationCommand}" Content="保存信息" HorizontalAlignment="Left"/></StackPanel>
            <StackPanel x:Name="InstanceCoverEditor" Grid.Column="1" Spacing="12"><Border Height="130" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource FieldBrush}"><Grid><Image Source="{Binding SelectedGameCover}" Stretch="{Binding SelectedGameCoverStretch}" IsVisible="{Binding HasGameCover}"/><icons:WorldArt IsVisible="{Binding !HasGameCover}"/></Grid></Border><Button Command="{Binding ChooseGameCoverCommand}" Content="更换封面"/><Button Classes="link" Command="{Binding RemoveGameCoverCommand}" Content="恢复默认"/></StackPanel>
          </Grid></Border>
          <Border Background="{DynamicResource FieldBrush}" CornerRadius="10" Padding="16"><Grid ColumnDefinitions="*,*" ColumnSpacing="20"><StackPanel Spacing="8"><TextBlock Text="内存" Classes="label"/><TextBlock Text="{Binding MemoryText}" FontSize="20" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><TextBlock Text="Java 运行环境" Classes="label"/><TextBlock Text="{Binding JavaText}" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></Border>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16"><StackPanel Spacing="6"><TextBlock Text="游戏账号" Classes="label"/><TextBlock Text="{Binding AccountText}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding AccountDetail}" Classes="label" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="1" Command="{Binding OpenAccountsCommand}" Content="切换账号" VerticalAlignment="Center"/></Grid>
        </StackPanel></ScrollViewer>
        <TransitioningContentControl x:Name="DetailTabHost" IsVisible="{Binding !IsOverviewTab}"/>
      </Grid>
    </Grid>
    <StackPanel Grid.Row="2" Spacing="8"><ProgressBar IsVisible="{Binding ExperienceBusy}" IsIndeterminate="True" Height="3"/><TextBlock Text="{Binding WorkspaceHint}" Classes="optional" TextWrapping="Wrap"/><TextBlock Text="{Binding ExperienceHint}" Classes="optional" FontSize="12" TextWrapping="Wrap" MaxHeight="50"/></StackPanel>
  </Grid>
</UserControl>
