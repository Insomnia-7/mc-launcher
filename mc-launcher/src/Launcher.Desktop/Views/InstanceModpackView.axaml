<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Launcher.App.ViewModels" xmlns:icons="using:Launcher.Desktop.Controls" x:DataType="vm:MainViewModel" x:Class="Launcher.Desktop.Views.InstanceModpackView">
  <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <Border Classes="card" Padding="20">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="8">
          <TextBlock Text="让喜欢的世界，继续生长。" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding PackIdentity}" Classes="muted" FontSize="14" TextTrimming="CharacterEllipsis"/>
          <TextBlock Text="先查看文件差异，保留自己的配置，再安心升级。" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="CheckPackVersionsButton" Command="{Binding CheckPackVersionsCommand}" IsEnabled="{Binding CanManagePack}" Classes="primary"><icons:IconLabel Icon="ActionRefresh" Text="检查平台版本" Foreground="{Binding $parent[Button].Foreground}"/></Button>
          <Button x:Name="ChoosePackUpdateButton" Command="{Binding PrepareLocalPackUpdateCommand}" IsEnabled="{Binding CanManagePack}" Content="选择本地更新包"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
      <ComboBox Width="112" ItemsSource="{Binding PackChannels}" SelectedItem="{Binding PackChannel}" IsEnabled="{Binding CanManagePack}" AutomationProperties.Name="整合包发布类型"/>
      <ComboBox x:Name="PackReleaseChoice" Grid.Column="1" ItemsSource="{Binding PackReleases}" SelectedItem="{Binding SelectedPackRelease}" PlaceholderText="检查版本后，选择要升级到的版本" IsEnabled="{Binding CanManagePack}"/>
      <Button Grid.Column="2" Command="{Binding PrepareOnlinePackUpdateCommand}" IsEnabled="{Binding CanManagePack}" Content="预览更新"/>
    </Grid>
    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="10">
      <TextBlock Text="{Binding PackPlanSummary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
        <StackPanel Spacing="10">
          <Border Classes="card" IsVisible="{Binding !HasPackPlan}" Padding="24">
            <StackPanel Spacing="12">
              <icons:UiIcon Kind="Tile.LoaderModpack" Width="56" Height="56" HorizontalAlignment="Left"/>
              <TextBlock Text="每次更新，都有回头路" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="新增和更新的文件会先下载并校验。你自行添加的内容会保留；文件发生冲突时，由你决定采用哪一份。" TextWrapping="Wrap" Classes="muted"/>
              <TextBlock Text="升级前的文件与版本信息会自动备份。存档不会随整合包升级而替换；新版游戏首次打开旧世界前，请先在「存档与备份」中备份。" TextWrapping="Wrap" Classes="muted"/>
            </StackPanel>
          </Border>
          <ItemsControl x:Name="PackChangeList" ItemsSource="{Binding PackChanges}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PackChangeRow">
            <Border Classes="card" Padding="14" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="5">
                  <WrapPanel><Border Background="{DynamicResource FieldBrush}" CornerRadius="5" Padding="7,2" Margin="0,0,8,0"><TextBlock Text="{Binding Kind}" FontSize="12" FontWeight="SemiBold"/></Border><TextBlock Text="{Binding Path}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="470" VerticalAlignment="Center" ToolTip.Tip="{Binding Path}"/></WrapPanel>
                  <TextBlock Text="{Binding Reason}" Classes="muted" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding Apply}" Content="{Binding ChoiceLabel}" VerticalAlignment="Center" IsEnabled="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).CanManagePack}"/>
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="3" Classes="card" Padding="14">
      <StackPanel Spacing="10">
        <ProgressBar IsVisible="{Binding PackBusy}" IsIndeterminate="True" Height="3"/>
        <TextBlock Text="{Binding PackHint}" Classes="muted" TextWrapping="Wrap"/>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8"><Button Command="{Binding RestorePackUpdateCommand}" IsVisible="{Binding HasPackRecovery}" IsEnabled="{Binding CanManagePack}" Content="恢复更新前"/><Button Command="{Binding CancelPackPreparationCommand}" IsVisible="{Binding PackBusy}" Content="取消准备"/></StackPanel>
          <Button x:Name="ApplyPackUpdateButton" Grid.Column="1" Command="{Binding ApplyPackUpdateCommand}" IsVisible="{Binding HasPackPlan}" IsEnabled="{Binding CanManagePack}" Classes="primary"><TextBlock Text="备份并应用更新" Foreground="{Binding $parent[Button].Foreground}"/></Button>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
