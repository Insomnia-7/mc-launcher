<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:Launcher.App.ViewModels" xmlns:icons="using:Launcher.Desktop.Controls" x:Class="Launcher.Desktop.Views.ToastView" x:DataType="vm:ToastItem" AutomationProperties.Name="{Binding Message}">
  <UserControl.Styles>
    <Style Selector="Border#ToastAccent"><Setter Property="Background" Value="{DynamicResource AccentStrongBrush}"/></Style>
    <Style Selector="Border#ToastAccent.success"><Setter Property="Background" Value="{DynamicResource SuccessBrush}"/></Style>
    <Style Selector="Border#ToastAccent.warning"><Setter Property="Background" Value="{DynamicResource WarnBrush}"/></Style>
    <Style Selector="Border#ToastAccent.error"><Setter Property="Background" Value="{DynamicResource DangerBrush}"/></Style>
  </UserControl.Styles>
  <Border x:Name="ToastSurface" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" BoxShadow="0 4 16 0 #20000000" Padding="14">
    <Grid ColumnDefinitions="20,*,24" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
      <Border x:Name="ToastAccent" Classes.success="{Binding IsSuccess}" Classes.warning="{Binding IsWarning}" Classes.error="{Binding IsError}" Width="0" Height="0"/>
      <icons:UiIcon Kind="{Binding IconKind}" Width="18" Height="18" Foreground="{Binding #ToastAccent.Background}" VerticalAlignment="Top"/>
      <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontSize="12" ToolTip.Tip="{Binding Message}"/>
      <Button Grid.Column="2" Classes="icon" Width="24" Height="24" MinHeight="24" Padding="4" Command="{Binding CloseCommand}" AutomationProperties.Name="关闭通知"><icons:UiIcon Kind="ActionClose" Width="14" Height="14"/></Button>
      <Button Grid.Row="1" Grid.Column="1" Classes="link" Content="{Binding ActionLabel}" Command="{Binding InvokeActionCommand}" IsVisible="{Binding HasAction}" IsEnabled="{Binding !IsClosing}" MinHeight="22" Padding="0" FontSize="12" HorizontalAlignment="Left"/>
    </Grid>
  </Border>
</UserControl>
