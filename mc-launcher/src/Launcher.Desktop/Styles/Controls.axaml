<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="using:Avalonia.Data.Converters" xmlns:local="using:Launcher.Desktop">
  <Styles.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#EEF0F5" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FieldBrush" Color="#F3F5F9" />
    <SolidColorBrush x:Key="HoverBrush" Color="#E5EAF4" />
    <SolidColorBrush x:Key="LineBrush" Color="#223E506E" />
    <SolidColorBrush x:Key="TextBrush" Color="#252B37" />
    <SolidColorBrush x:Key="MutedBrush" Color="#656F80" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4669AB" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#4669AB" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#184669AB" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#99080D18" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E36D76" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CAF95" />
    <SolidColorBrush x:Key="GlassEdgeBrush" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="WallpaperTintBrush" Color="#45EEF0F5" />
    <SolidColorBrush x:Key="BackdropGlowBrush" Color="Transparent" />
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, Noto Sans CJK SC, PingFang SC, Segoe UI, sans-serif" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
  </Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="10" /><Setter Property="LetterSpacing" Value="2" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.optional"><Setter Property="IsVisible" Value="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" /></Style>
  <Style Selector="Border.card"><Setter Property="CornerRadius" Value="20" /><Setter Property="Padding" Value="22" /><Setter Property="Background" Value="{DynamicResource CardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="Border.modal-surface"><Setter Property="CornerRadius" Value="24" /><Setter Property="Padding" Value="28" /><Setter Property="Background" Value="{DynamicResource PanelBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="BoxShadow" Value="0 20 80 0 #40000000" /><Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="MaxWidth" Value="620" /><Setter Property="Margin" Value="28" /></Style>
  <Style Selector="Grid.modal"><Setter Property="Background" Value="{DynamicResource OverlayBrush}" /><Setter Property="IsVisible" Value="False" /><Setter Property="ZIndex" Value="20" /></Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource FieldBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" /><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="16,8" /><Setter Property="Cursor" Value="Hand" /><Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="RenderTransformOrigin" Value="50%,50%" /><Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions"><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22"><TransformOperationsTransition.Easing><local:SoftSpringEasing /></TransformOperationsTransition.Easing></TransformOperationsTransition><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions></Setter>
    <Setter Property="Template"><ControlTemplate><Border Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" /></Border></ControlTemplate></Setter>
  </Style>
  <Style Selector="Button:pointerover"><Setter Property="RenderTransform" Value="translate(0px,-1px) scale(1.01)" /></Style>
  <Style Selector="Button:pointerover /template/ Border#Surface"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button:pressed"><Setter Property="RenderTransform" Value="scale(0.97)" /><Setter Property="Opacity" Value="0.9" /></Style>
  <Style Selector="Button:focus-visible /template/ Border#Surface"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.42" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentFillBrush}" /><Setter Property="Foreground" Value="White" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeBrush}" /></Style>
  <Style Selector="Button.primary:pointerover /template/ Border#Surface"><Setter Property="Background" Value="{DynamicResource AccentFillBrush}" /><Setter Property="Opacity" Value="0.88" /></Style>
  <Style Selector="Button.quiet"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
  <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Button.nav.active"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /></Style>
  <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
  <Style Selector="ListBox"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="12" /><Setter Property="Margin" Value="0,3" /><Setter Property="CornerRadius" Value="12" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource SelectedBrush}" /></Style>
  <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="{DynamicResource FieldBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="MinHeight" Value="38" /></Style>
  <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="{DynamicResource FieldBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="MinHeight" Value="38" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="Window.reduced-motion Button"><Setter Property="Transitions"><Transitions /></Setter></Style>
  <Style Selector="ToggleButton.theme-switch">
    <Setter Property="Width" Value="70" /><Setter Property="Height" Value="36" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template"><ControlTemplate>
      <Border CornerRadius="18" Background="#172844" BorderBrush="#50FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Grid>
          <Border Name="DaySky" Background="#9CD8EF" Opacity="0"><Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.26" /></Transitions></Border.Transitions></Border>
          <Ellipse Classes="star star1" Width="3" Height="3" Fill="White" Margin="13,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
          <Ellipse Classes="star star2" Width="2" Height="2" Fill="White" Margin="24,21,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
          <Ellipse Classes="star star3" Width="2" Height="2" Fill="White" Margin="32,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
          <Border Name="Thumb" Width="26" Height="26" CornerRadius="13" Background="#FAFCFF" HorizontalAlignment="Left" Margin="4" RenderTransform="translate(32px,0px)" BoxShadow="0 1 6 0 #50000000">
            <Border.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.38"><TransformOperationsTransition.Easing><local:SoftSpringEasing /></TransformOperationsTransition.Easing></TransformOperationsTransition></Transitions></Border.Transitions>
            <Grid><Ellipse Name="Sun" Width="12" Height="12" Fill="#F4BF45" Opacity="0" /><Path Name="Moon" Data="M 15,3 A 10,10 0 1 0 21,17 A 10,10 0 0 1 15,3 Z" Fill="#8796CF" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
          </Border>
        </Grid>
      </Border>
    </ControlTemplate></Setter>
  </Style>
  <Style Selector="ToggleButton.theme-switch:checked /template/ Border#DaySky"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="ToggleButton.theme-switch:checked /template/ Border#Thumb"><Setter Property="RenderTransform" Value="translate(0px,0px)" /></Style>
  <Style Selector="ToggleButton.theme-switch:checked /template/ Ellipse#Sun"><Setter Property="Opacity" Value="1" /></Style>
  <Style Selector="ToggleButton.theme-switch:checked /template/ Path#Moon"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="ToggleButton.theme-switch:checked /template/ Ellipse.star"><Setter Property="Opacity" Value="0" /></Style>
  <Style Selector="ToggleButton.theme-switch /template/ Ellipse.star1"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" Delay="0:0:0.06" /></Transitions></Setter></Style>
  <Style Selector="ToggleButton.theme-switch /template/ Ellipse.star2"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" Delay="0:0:0.1" /></Transitions></Setter></Style>
  <Style Selector="ToggleButton.theme-switch /template/ Ellipse.star3"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" Delay="0:0:0.14" /></Transitions></Setter></Style>
  <Style Selector="Window.reduced-motion ToggleButton.theme-switch /template/ Border"><Setter Property="Transitions"><Transitions /></Setter></Style>
  <Style Selector="Window.reduced-motion ToggleButton.theme-switch /template/ Ellipse"><Setter Property="Transitions"><Transitions /></Setter></Style>
</Styles>
