<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">
  <Styles.Resources>
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI, sans-serif</FontFamily>

    <sys:Double x:Key="FontSizePageTitle">26</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeCardTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBadge">11</sys:Double>

    <Thickness x:Key="SpaceMicro">4</Thickness>
    <Thickness x:Key="SpaceCompact">8</Thickness>
    <Thickness x:Key="SpaceRegular">12</Thickness>
    <Thickness x:Key="SpaceStandard">16</Thickness>
    <Thickness x:Key="SpaceMedium">20</Thickness>
    <Thickness x:Key="SpaceModule">24</Thickness>
    <Thickness x:Key="SpaceSection">32</Thickness>
    <Thickness x:Key="SpaceLarge">40</Thickness>

    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">16</CornerRadius>
  </Styles.Resources>
</Styles>
