<Project>
  <Import Project="WindowsSingleFile.pubxml" />
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Existing account, version and settings stores use reflection-based JSON. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebuggerSupport>false</DebuggerSupport>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- Preserve all business models, constructors and members used by JSON/DI.
         Partial mode trims opted-in dependencies; no launcher feature is removed. -->
    <TrimmerRootAssembly Include="MCLauncher.Desktop" />
    <TrimmerRootAssembly Include="Launcher.Application" />
    <TrimmerRootAssembly Include="Launcher.Domain" />
    <TrimmerRootAssembly Include="Launcher.Infrastructure" />
  </ItemGroup>
</Project>
