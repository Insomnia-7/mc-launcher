<UserControl x:Class="Launcher.App.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFontFamily}">
    <UserControl.Resources>
        <Style x:Key="OptionalText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource OverlayBrush}" KeyboardNavigation.TabNavigation="Cycle">
        <Border x:Name="DialogSurface" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="20" Padding="26,24" MaxWidth="560" Margin="24"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="开始你的 Minecraft" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="选好版本与身份，游戏和所需 Java 交给启动器准备。" Margin="0,8,0,0"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel IsEnabled="{Binding CanEditSetup}" Margin="0,0,12,0">
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="1 · 游戏版本" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Button Content="刷新版本" Command="{Binding ReloadSetupVersionsCommand}" HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" FontSize="12" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding SetupVersions}" SelectedItem="{Binding SetupVersion}"
                                  Style="{StaticResource DarkComboBox}" AutomationProperties.Name="游戏版本">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Id}" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="仅列出正式版；快照和加载器可在下载页安装。" FontSize="12" Margin="0,6,0,16"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="2 · 游戏内存（MB）" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8" />
                        <TextBox Text="{Binding SetupMemoryText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                                 AutomationProperties.Name="游戏内存" />
                        <TextBlock Text="已按本机内存推荐；可填写 512–65536 MB。" FontSize="12" Margin="0,6,0,16"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="3 · 游戏身份" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Button Content="选择 / 添加账号" Command="{Binding OpenAccountsCommand}" HorizontalAlignment="Right"
                                    Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" FontSize="12" />
                        </Grid>
                        <TextBlock Text="{Binding SetupIdentityText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBox Text="{Binding SetupOfflineName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}"
                                 AutomationProperties.Name="离线用户名" IsReadOnly="{Binding HasAccount}" />
                        <TextBlock Text="离线身份可用于单人游戏，无法加入需要正版验证的服务器。" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LoginCode}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource AccentBrush}" FontSize="18" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding LoginHint}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                        <Button Content="取消登录" Command="{Binding LoginCancelCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Height="28" Padding="12,0" Margin="0,8,0,0"
                                Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}" />
                        <CheckBox Content="安装完成后启动游戏" IsChecked="{Binding SetupLaunchAfterInstall}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,16,0,4" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="{Binding SetupError}" Style="{StaticResource OptionalText}" Foreground="#FF9292" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <Button Content="网络设置…" Command="{Binding OpenNetworkCommand}" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" HorizontalAlignment="Left" Margin="0,0,0,6" />
                    <!-- 游戏目录不可用时，向导自己的「重试」只会一次次撞同一面墙，先换目录 -->
                    <Button Content="换个游戏目录…" Command="{Binding ChooseGameRootCommand}" Style="{StaticResource SecondaryButton}" Height="28" Padding="12,0" HorizontalAlignment="Left" Margin="0,0,0,6"
                            Visibility="{Binding HasGameRootProblem, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding SetupStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding ProgressPercent}" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="100"
                                 Visibility="{Binding IsSetupBusy, Converter={StaticResource BoolToVis}}"
                                 Foreground="{DynamicResource AccentBrush}" Background="#3C3C44" BorderThickness="0" />
                </StackPanel>
                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Button Content="稍后设置" Command="{Binding CloseSetupCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0" HorizontalAlignment="Left" />
                    <Button Grid.Column="1" Content="取消安装" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0"
                            Visibility="{Binding IsSetupBusy, Converter={StaticResource BoolToVis}}" />
                    <!-- 失败后不用重新挑版本：沿用当前选择再试一次（两者互斥，不会同时出现） -->
                    <Button Grid.Column="1" Content="重试安装" Command="{Binding InstallSetupCommand}" Style="{StaticResource SecondaryButton}" Height="36" Padding="16,0"
                            Visibility="{Binding CanRetrySetup, Converter={StaticResource BoolToVis}}" />
                    <Button Grid.Column="3" Content="一键安装" Command="{Binding InstallSetupCommand}" Style="{StaticResource PrimaryButton}"
                            Height="36" MinWidth="112" FontSize="14" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
