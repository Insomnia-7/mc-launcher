<UserControl x:Class="Launcher.App.Views.AppearanceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource OverlayBrush}" KeyboardNavigation.TabNavigation="Cycle">
  <Border x:Name="DialogSurface" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="22" MaxWidth="640" MaxHeight="570" Margin="20" Padding="26" VerticalAlignment="Center" HorizontalAlignment="Stretch">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="外观" Style="{StaticResource H1Text}"/><TextBlock Text="选择配色，让喜欢的壁纸融入界面。" Style="{StaticResource CaptionText}" Margin="0,7,0,0"/></StackPanel>
     <Button Grid.Column="1" Content="×" FontSize="22" Width="32" VerticalAlignment="Top" Style="{StaticResource GhostButton}" Command="{Binding CloseAppearanceCommand}" ToolTip="关闭 · Esc"/>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel IsEnabled="{Binding CanEditAppearance}" Margin="0,0,4,0">
      <TextBlock Text="主题" Style="{StaticResource H2Text}" Margin="0,0,0,10"/>
      <ListBox x:Name="ThemeList" ItemsSource="{Binding ThemeChoices}" SelectedItem="{Binding SelectedTheme}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="主题配色">
       <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
         <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
         <Setter Property="Height" Value="82"/><Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
           <Border x:Name="Tile" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="14" Margin="0,0,8,8"><ContentPresenter Margin="12"/></Border>
           <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
           </ControlTemplate.Triggers>
          </ControlTemplate>
         </Setter.Value></Setter>
        </Style>
       </ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate>
<DataTemplate><Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Width="66" Height="46" CornerRadius="9" Background="{Binding Swatch}" BorderBrush="{Binding LineBrush}" BorderThickness="1" HorizontalAlignment="Left">
<Grid Margin="5"><Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="{Binding PanelBrush}" CornerRadius="3"/>
<StackPanel Grid.Column="2"><Border Background="{Binding CardBrush}" CornerRadius="2" Height="7"/><Border Background="{Binding CardBrush}" CornerRadius="2" Height="7" Margin="0,3,0,0"/><Border Background="{Binding Accent}" CornerRadius="2" Height="5" Width="26" HorizontalAlignment="Left" Margin="0,3,0,0"/></StackPanel>
</Grid>
</Border>
<TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
</Grid></DataTemplate>
</ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Margin="0,2,0,18"><Button Content="导入主题" Command="{Binding ImportThemeCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,8,0"/><Button Content="导出配色" Command="{Binding ExportThemeCommand}" Style="{StaticResource GhostButton}" Height="32"/></WrapPanel>
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,18"/>
      <Grid Margin="0,0,0,10">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="壁纸" Style="{StaticResource H2Text}" VerticalAlignment="Center"/>
       <Button Grid.Column="1" Content="选择图片" Command="{Binding ImportWallpaperCommand}" Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,8,0"/>
       <Button Grid.Column="2" Content="恢复默认" Command="{Binding RemoveWallpaperCommand}" Style="{StaticResource GhostButton}" Height="32"/>
      </Grid>
      <Grid Margin="0,0,0,5">
       <Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
       <TextBlock Text="显示强度" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
       <Slider Grid.Column="1" Minimum="0" Maximum="0.85" Value="{Binding WallpaperOpacity}" SmallChange="0.05" VerticalAlignment="Center" AutomationProperties.Name="壁纸强度"/>
       <TextBlock Grid.Column="2" Text="{Binding WallpaperOpacity,StringFormat={}{0:P0}}" Style="{StaticResource CaptionText}" TextAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="支持 PNG、JPG、BMP，最大 24 MB。原图片会保留。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,0,18"/>
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,18"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="164"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="切换动画" Style="{StaticResource H2Text}"/><TextBlock Text="页面过渡与弹窗进出效果" Style="{StaticResource CaptionText}" Margin="0,5,10,0"/></StackPanel>
       <ComboBox Grid.Column="1" ItemsSource="{Binding MotionChoices}" SelectedItem="{Binding SelectedMotion}" DisplayMemberPath="Name" AutomationProperties.Name="切换动画"/>
      </Grid>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,22,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding AppearanceHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,0,16,0" VerticalAlignment="Center"/>
     <Button Grid.Column="1" Content="完成" Command="{Binding CloseAppearanceCommand}" Style="{StaticResource PrimaryButton}" MinWidth="88"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</UserControl>
