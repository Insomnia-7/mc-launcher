<UserControl x:Class="Launcher.App.Views.NetworkSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource OverlayBrush}">
        <Border x:Name="DialogSurface" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                CornerRadius="20" Padding="26" Margin="24" MaxWidth="580" MaxHeight="470"
                HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="网络设置" Style="{StaticResource BodyText}" FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock Text="用于游戏与资源下载、微软登录、Java 下载及更新检查。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding ActiveNetworkText, StringFormat='当前：{0}'}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                    <TextBlock Text="连接方式" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding ProxyModes}" SelectedIndex="{Binding ProxyModeIndex}" Style="{StaticResource DarkComboBox}" AutomationProperties.Name="代理模式"/>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsCustomProxy, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="代理地址" Style="{StaticResource CaptionText}" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DarkTextBox}" AutomationProperties.Name="代理地址"/>
                        <TextBlock Text="例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080。不支持需要账号密码的代理；连接失败会报错。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NetworkHint}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <WrapPanel Margin="0,18,0,0" HorizontalAlignment="Right">
                        <Button Content="关闭" Command="{Binding CloseNetworkCommand}" Style="{StaticResource SecondaryButton}" Height="32" MinWidth="80" Margin="0,0,8,0"/>
                        <Button Content="保存" Command="{Binding SaveNetworkCommand}" Style="{StaticResource PrimaryButton}" Height="32" MinWidth="80"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
