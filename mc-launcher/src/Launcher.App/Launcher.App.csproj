<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MCLauncher</AssemblyName>
    <RootNamespace>Launcher.App</RootNamespace>
    <ApplicationIcon />
    <Version>0.1.1</Version>
    <FileVersion>0.1.1.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Application\Launcher.Application.csproj" />
    <ProjectReference Include="..\Launcher.Infrastructure\Launcher.Infrastructure.csproj" />
    <!-- 只为了让它先构建：更新器要整份复制到输出目录的 updater\ 下 -->
    <ProjectReference Include="..\..\tools\Launcher.Updater\Launcher.Updater.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Target Name="CopyUpdater" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\tools\Launcher.Updater\bin\$(Configuration)\net10.0\mclupd.exe')">
    <ItemGroup>
      <UpdaterFiles Include="$(MSBuildThisFileDirectory)..\..\tools\Launcher.Updater\bin\$(Configuration)\net10.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutDir)updater\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
