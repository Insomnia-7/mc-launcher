<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>MCLauncher</AssemblyName>
    <RootNamespace>Launcher.App</RootNamespace>
    <ApplicationIcon />
    <Version>0.1.2</Version>
    <FileVersion>0.1.2.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Launcher.Application\Launcher.Application.csproj" />
    <ProjectReference Include="..\Launcher.Infrastructure\Launcher.Infrastructure.csproj" />
    <!-- 只为了让它先构建：更新器要整份复制到输出目录的 updater\ 下 -->
    <ProjectReference Include="..\..\tools\Launcher.Updater\Launcher.Updater.csproj"
                      Condition="'$(PublishSingleFile)' != 'true'">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup Condition="'$(UpdaterPayload)' != ''">
    <EmbeddedResource Include="$(UpdaterPayload)" LogicalName="Launcher.Updater.mclupd.exe" />
  </ItemGroup>

  <Target Name="ValidateUpdaterPayload" BeforeTargets="CoreCompile" Condition="'$(PublishSingleFile)' == 'true'">
    <Error Condition="'$(UpdaterPayload)' == '' Or !Exists('$(UpdaterPayload)')"
           Text="单文件发布必须提供已发布的更新器：-p:UpdaterPayload=&lt;mclupd.exe 的绝对路径&gt;。" />
  </Target>

  <Target Name="CopyUpdater" AfterTargets="Build"
          Condition="'$(PublishSingleFile)' != 'true' And Exists('$(MSBuildThisFileDirectory)..\..\tools\Launcher.Updater\bin\$(Configuration)\net10.0\mclupd.exe')">
    <ItemGroup>
      <UpdaterFiles Include="$(MSBuildThisFileDirectory)..\..\tools\Launcher.Updater\bin\$(Configuration)\net10.0\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(UpdaterFiles)" DestinationFolder="$(OutDir)updater\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.Checks 要直接驱动 WindowChrome（内部静态），否则测不到真实的标题栏状态 -->
    <InternalsVisibleTo Include="App.Checks" />
  </ItemGroup>
</Project>
