<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Launcher.App.ViewModels"
        xmlns:views="clr-namespace:Launcher.App.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MC Launcher" Height="640" Width="1000"
        MinHeight="560" MinWidth="820"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        WindowStartupLocation="CenterScreen">

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══════════ 左栏 ══════════ -->
        <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource PanelBrush}">
            <DockPanel>
                <!-- 顶部两个分区按钮：游戏版本 / 下载 -->
                <Grid DockPanel.Dock="Top" Margin="12,14,12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="游戏版本" Height="34"
                            Command="{Binding ShowInstancesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstanceSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2" Content="下载" Height="34"
                            Command="{Binding ShowDownloadsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloadSection}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Button DockPanel.Dock="Bottom" Content="安装向导…" Command="{Binding OpenSetupCommand}" Margin="12,0,12,12" Height="34" Style="{StaticResource SecondaryButton}" />

                <!-- 版本列表 -->
                <ListBox ItemsSource="{Binding Instances}"
                         SelectedItem="{Binding SelectedInstance}"
                         ItemContainerStyle="{StaticResource InstanceItem}"
                         Background="Transparent" BorderThickness="0"
                         Margin="8,0,8,12"
                         MouseDoubleClick="OnInstanceListDoubleClick"
                         Visibility="{Binding IsInstanceSection, Converter={StaticResource BoolToVis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ContextMenu>
                        <!-- ContextMenu 不在主视觉树里，绑不到窗口的 DataContext，要从 PlacementTarget 借 -->
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Background="#2A2A30" Foreground="{StaticResource TextBrush}"
                                     BorderBrush="#3C3C44">
                            <MenuItem Header="打开游戏目录" Command="{Binding OpenGameDirectoryCommand}" />
                            <MenuItem Header="打开版本目录" Command="{Binding OpenInstanceFolderCommand}" />
                            <MenuItem Header="打开日志目录" Command="{Binding OpenLogsCommand}" />
                            <Separator />
                            <MenuItem Header="删除版本…" Command="{Binding DeleteInstanceCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                           FontFamily="Microsoft YaHei UI"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontFamily="Microsoft YaHei UI"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 下载分类导航：游戏本体 + 模组 | 一条线 | 整合包 / 资源包 / 数据包 / 光影包 -->
                <ScrollViewer Margin="8,0,8,12"
                              Visibility="{Binding IsDownloadSection, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Download.Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 分隔项只画一条线 -->
                                    <Border Height="1" Background="#3C3C44" Margin="6,8"
                                            Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />
                                    <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                                            Height="44" HorizontalContentAlignment="Stretch"
                                            Visibility="{Binding IsNormal, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                    CornerRadius="6" Padding="12,0">
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                   FontFamily="Microsoft YaHei UI"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══════════ 右：版本页 ══════════ -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsInstanceSection, Converter={StaticResource BoolToVis}}">
            <Grid Margin="32,28,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <TextBlock Text="{Binding SelectedInstance.DisplayName, FallbackValue='还没有版本'}"
                           Style="{StaticResource BodyText}" FontSize="24"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedInstance.Subtitle, FallbackValue='先装一个版本'}"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                <Border Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12,9" Margin="0,16,0,0">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding AccountText}" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AccountDetail}" FontSize="11" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="账号管理…" Command="{Binding OpenAccountsCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0"/>
                            <Button Content="取消登录" Command="{Binding LoginCancelCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Margin="8,0,0,0"
                                    Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding LoginHint}" FontSize="11" Margin="2,8,0,0"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Button Grid.Row="1" Content="启动游戏"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LaunchCommand}"
                    Margin="0,0,0,12" />

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="导入本地整合包（.mrpack / .zip）"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ImportModpackCommand}" />
                <Button Grid.Column="2" Content="导出备份…" MinWidth="104"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportInstanceCommand}" />
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,0,0,20">
                <!-- 进度条同一行右侧挂「取消」：卡在 4px 条上太窄，用 Grid 两列，CanCancel 为假时按钮 Collapsed 不占位 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0" Height="4"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 VerticalAlignment="Center"
                                 Background="{StaticResource PanelBrush}"
                                 Foreground="{StaticResource AccentBrush}"
                                 BorderThickness="0" />

                    <Button Grid.Column="1" Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Height="26" FontSize="12" Padding="14,0" MinWidth="72"
                            Margin="12,0,0,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 启动失败诊断：把日志里的崩溃签名翻译成能照做的建议 -->
                <Border Background="#33D9534F" BorderBrush="#D9534F" BorderThickness="1"
                        CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                        Visibility="{Binding HasDiagnosis, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="启动失败" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FF8A80" FontFamily="Microsoft YaHei UI" />
                        <TextBlock Text="{Binding DiagnosisText}" FontSize="12" TextWrapping="Wrap"
                                   LineHeight="19" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextBrush}"
                                   FontFamily="Microsoft YaHei UI" />
                        <!-- 一键把「诊断 + 版本 + 游戏目录 + 时间」贴进剪贴板，省得用户手抄日志路径 -->
                        <Button Content="复制诊断"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding CopyDiagnosisCommand}"
                                Visibility="{Binding HasDiagnosis, Converter={StaticResource BoolToVis}}"
                                Height="26" Padding="14,0" FontSize="12"
                                HorizontalAlignment="Right" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 版本设置：平时收起不占地方，展开可改内存 / Java / 额外参数 -->
            <Expander Grid.Row="5" IsExpanded="{Binding IsSettingsOpen, Mode=TwoWay}"
                      HorizontalContentAlignment="Stretch" Margin="0,0,0,14"
                      Foreground="{StaticResource MutedBrush}">
                <Expander.Header>
                    <TextBlock Text="版本设置" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                </Expander.Header>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内存" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <Slider Grid.Column="1" Minimum="512" Maximum="32768"
                                    SmallChange="512" LargeChange="2048"
                                    TickFrequency="512" IsSnapToTickEnabled="True"
                                    Value="{Binding MemoryMb}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding MemoryMb, StringFormat='{}{0} MB'}"
                                       VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Java" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding JavaOptions}"
                                      SelectedItem="{Binding SelectedJava}" DisplayMemberPath="Title"
                                      Style="{StaticResource DarkComboBox}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="档位" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding JvmPresetIndex}"
                                      Style="{StaticResource DarkComboBox}"
                                      ToolTip="默认：不加额外 JVM 参数；快速：G1 调优（在 Java 21 上实测反而慢一点，慎用）；兼容：只加 -XX:+UseG1GC">
                                <ComboBoxItem Content="默认" />
                                <ComboBoxItem Content="快速（G1 调优）" />
                                <ComboBoxItem Content="兼容（最保险）" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="下载源" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DownloadSources}"
                                      SelectedIndex="{Binding DownloadSourceIndex}"
                                      Style="{StaticResource DarkComboBox}"
                                      ToolTip="镜像走 bmclapi2.bangbang93.com，国内访问更快；切完下一批下载立刻生效，不用重启" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JVM 参数" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding ExtraJvmArgs, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="-XX:+UseG1GC -XX:MaxGCPauseMillis=50 之类；空格分隔，带空格的参数用双引号包住" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="游戏参数" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding ExtraGameArgs, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="追加到游戏参数末尾，例如 --width 1920 --height 1080" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="窗口" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="×" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBox Grid.Column="3" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SettingsHint}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="保存设置" Height="30" Width="92" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SaveSettingsCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- 模组：本地扫描 + 上游更新检查；更新会删旧文件再下新版，走确认气泡 -->
            <Expander Grid.Row="6" Margin="0,0,0,14" Foreground="{StaticResource MutedBrush}"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="模组" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                </Expander.Header>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16,14" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ModSummary}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource TextBrush}" />
                            <Button Grid.Column="1" Content="刷新" Height="28" MinWidth="64" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshModsCommand}" />
                            <Button Grid.Column="3" Content="检查更新" Height="28" MinWidth="80" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CheckModUpdatesCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding ModWarnings}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="#FFE08A3C"
                                   Visibility="{Binding HasModWarnings, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding InstalledMods}" MaxHeight="220">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Height="20" VerticalAlignment="Center"
                                                Background="#FF3C3C44">
                                            <TextBlock Text="{Binding StateText}" FontSize="11" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding ModUpdates}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="12,0,12,0"
                                                   Foreground="{StaticResource AccentBrush}" />
                                        <Button Grid.Column="2" Content="更新" Height="26" MinWidth="60" FontSize="12"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.UpdateModCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Expander>

            <Border Grid.Row="7" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="16"
                    VerticalAlignment="Top">
                <TextBlock Text="{Binding EmptyStateHint}" Style="{StaticResource BodyText}"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" LineHeight="22" />
            </Border>
            </Grid>
        </ScrollViewer>

        <!-- ══════════ 右：下载页 ══════════ -->
        <Grid Grid.Row="0" Grid.Column="1" Margin="32,28,32,20"
              Visibility="{Binding IsDownloadSection, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 当前目标 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{Binding Download.SelectedCategory.Title, FallbackValue='下载中心'}"
                           Style="{StaticResource BodyText}" FontSize="24" />
                <TextBlock Text="{Binding Download.SelectedCategory.Hint}"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Download.TargetText}"
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding Download.IsVersionMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="下载源" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,10,0" />
                    <Button Content="官方" Height="26" Padding="14,0" FontSize="12"
                            Command="{Binding Download.UseDownloadSourceCommand}" CommandParameter="official">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Download.IsOfficialSource}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="BMCLAPI 镜像" Height="26" Padding="14,0" FontSize="12" Margin="8,0,0,0"
                            Command="{Binding Download.UseDownloadSourceCommand}" CommandParameter="bmclapi"
                            ToolTip="国内镜像。libraries / assets / Forge 与 Fabric maven 走镜像；client.jar 等大文件只做 302 回源，不会变快">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Download.IsBmclapiSource}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- All content kinds share source/category/version/sort and server-side paging. -->
            <StackPanel Grid.Row="1" Margin="0,0,0,10"
                        Visibility="{Binding Download.IsSearchMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="名称 / 关键词（留空查看热门）" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                <Grid IsEnabled="{Binding Download.CanEditSearch}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <TextBox Height="32" Margin="0,0,8,0" VerticalContentAlignment="Center" Padding="8,0"
                             Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderThickness="0"
                             ToolTip="{Binding Download.SearchHint}" Text="{Binding Download.Query, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Download.SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Download.Sources}" SelectedItem="{Binding Download.SelectedSource}" ToolTip="下载来源"/>
                </Grid>
                <WrapPanel Margin="0,8,0,0" IsEnabled="{Binding Download.CanEditSearch}">
                    <StackPanel Width="150" Margin="0,0,8,5"><TextBlock Text="游戏版本（可输入）" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox Height="28" IsEditable="True" ItemsSource="{Binding Download.GameVersions}" Text="{Binding Download.GameVersionFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Width="140" Margin="0,0,8,5"><TextBlock Text="内容分类" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox Height="28" ItemsSource="{Binding Download.ResourceTags}" SelectedItem="{Binding Download.SelectedTag}" DisplayMemberPath="Name"/></StackPanel>
                    <StackPanel Width="115" Margin="0,0,8,5" Visibility="{Binding Download.ShowsLoaderFilter, Converter={StaticResource BoolToVis}}"><TextBlock Text="加载器" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox Height="28" ItemsSource="{Binding Download.Loaders}" SelectedItem="{Binding Download.LoaderFilter}"/></StackPanel>
                    <StackPanel Width="135" Margin="0,0,0,5"><TextBlock Text="排序" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox Height="28" ItemsSource="{Binding Download.SortOptions}" SelectedItem="{Binding Download.SelectedSort}" DisplayMemberPath="Name" ToolTip="{Binding Download.SortHint}"/></StackPanel>
                </WrapPanel>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="搜索" Height="28" Padding="16,0" Margin="0,0,8,4" Style="{StaticResource SecondaryButton}" Command="{Binding Download.SearchCommand}"/>
                    <Button Content="重置条件" Height="28" Padding="12,0" Margin="0,0,8,4" Style="{StaticResource SecondaryButton}" Command="{Binding Download.ResetFiltersCommand}"/>
                    <Button Content="热门推荐" Height="28" Padding="12,0" Margin="0,0,8,4" Style="{StaticResource SecondaryButton}" Command="{Binding Download.PopularCommand}"/>
                    <Button Content="安装已有整合包…" Height="28" Padding="12,0" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Command="{Binding ImportModpackCommand}"/>
                </WrapPanel>
            </StackPanel>

            <!-- CurseForge 未配置提示 -->
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding Download.ShowsCurseForgeHint, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="18"
                           Text="CurseForge 需要 API Key：到 console.curseforge.com 免费申请（Core 计划），填入数据目录下 settings.json 的 curseForgeApiKey，或设置环境变量 CURSEFORGE_API_KEY。Modrinth 源无需任何配置。" />
            </Border>

            <!-- 最新版本（PCL 样式：最新正式版 + 最新预览版） -->
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,10"
                    Visibility="{Binding Download.IsVersionMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="最新版本" FontSize="12" Margin="0,0,0,6"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="Microsoft YaHei UI" />
                    <ItemsControl ItemsSource="{Binding Download.LatestVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch" Height="34" Margin="0,1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="4" Padding="8,0">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Microsoft YaHei UI" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReleaseDateText}" FontSize="11"
                                                   VerticalAlignment="Center" Margin="8,0,2,0"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="Microsoft YaHei UI" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <WrapPanel Grid.Row="3" Margin="0,0,0,6" Visibility="{Binding Download.IsSearchMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Download.ResultHeading}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                <Button Content="首页" Style="{StaticResource SecondaryButton}" Command="{Binding Download.FirstPageCommand}" Height="25" Margin="0,0,4,4" Padding="8,0"/>
                <Button Content="上一页" Style="{StaticResource SecondaryButton}" Command="{Binding Download.PreviousPageCommand}" Height="25" Margin="0,0,8,4" Padding="8,0"/>
                <TextBlock Text="{Binding Download.PageText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <Button Content="下一页" Style="{StaticResource SecondaryButton}" Command="{Binding Download.NextPageCommand}" Height="25" Margin="0,0,4,4" Padding="8,0"/>
                <Button Content="末页" Style="{StaticResource SecondaryButton}" Command="{Binding Download.LastPageCommand}" Height="25" Margin="0,0,0,4" Padding="8,0"/>
            </WrapPanel>

            <!-- 结果列表（两种模式共用一块区域）-->
            <Grid Grid.Row="4">
                <ListBox ItemsSource="{Binding Download.Results}"
                         SelectedItem="{Binding Download.SelectedResult}"
                         ItemContainerStyle="{StaticResource InstanceItem}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding Download.IsSearchMode, Converter={StaticResource BoolToVis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="56">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource SelectedBrush}"
                                        CornerRadius="4" Padding="7,2" VerticalAlignment="Center"
                                        Margin="0,0,10,0" MinWidth="30">
                                    <TextBlock Text="{Binding Badge}" FontSize="11"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="14"
                                               FontFamily="Microsoft YaHei UI"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               FontFamily="Microsoft YaHei UI"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Author}" /><Run Text=" · " /><Run Text="{Binding MetaText}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" FontSize="11"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontFamily="Microsoft YaHei UI"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 版本列表：按大版本号分组（26 / 1 / 23…），组里直接列完整版本号 -->
                <ScrollViewer Visibility="{Binding Download.IsVersionMode, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Download.VersionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,2">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Header}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   FontFamily="Microsoft YaHei UI" />
                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Versions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding SelectCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Height="32" Margin="0,1">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="BorderThickness" Value="0" />
                                                                            <Setter Property="Cursor" Value="Hand" />
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="Bd"
                                                                                                Background="{TemplateBinding Background}"
                                                                                                CornerRadius="4" Padding="10,0">
                                                                                            <ContentPresenter VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Bd" Property="Background"
                                                                                                        Value="{StaticResource HoverBrush}" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{StaticResource TextBrush}"
                                                                                   FontFamily="Microsoft YaHei UI"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding ReleaseDateText}" FontSize="11"
                                                                                   VerticalAlignment="Center" Margin="8,0,2,0"
                                                                                   Foreground="{StaticResource MutedBrush}"
                                                                                   FontFamily="Microsoft YaHei UI" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 进度 -->
            <StackPanel Grid.Row="5" Margin="0,12,0,0">
                <ProgressBar Height="4" Minimum="0" Maximum="100"
                             Value="{Binding Download.ProgressPercent}"
                             Background="{StaticResource PanelBrush}"
                             Foreground="{StaticResource AccentBrush}"
                             BorderThickness="0" Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Download.Status}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 状态文字右侧的「取消」：只在该页有任务时出现，不挤压右边的安装按钮 -->
                    <Button Grid.Column="1" Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Height="26" MinWidth="72" Padding="14,0" FontSize="12"
                            Margin="12,0,12,0" VerticalAlignment="Center"
                            Command="{Binding Download.CancelCommand}"
                            Visibility="{Binding Download.CanCancel, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="2" Content="安装到版本" Height="40" MinWidth="128"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding Download.InstallCommand}"
                            Visibility="{Binding Download.IsSearchMode, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="2" Content="下载并安装" Height="40" MinWidth="128"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding Download.InstallVersionCommand}"
                            Visibility="{Binding Download.IsVersionMode, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- 底部状态条 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Margin="16,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                           FontFamily="Microsoft YaHei UI"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UpdateText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}"
                               FontFamily="Microsoft YaHei UI" Margin="0,0,10,0" />
                    <Button Content="立即更新" Command="{Binding ApplyUpdateCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="22" FontSize="11" Padding="12,0" MinWidth="72" />
                </StackPanel>
            </Grid>
        </Border>

        <views:FirstRunView Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="90"
                            Visibility="{Binding IsSetupOpen, Converter={StaticResource BoolToVis}}" />

        <views:AccountManagerView Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="95"
                                  Visibility="{Binding IsAccountsOpen, Converter={StaticResource BoolToVis}}" />

        <!-- 确认覆盖层：不用 Popup（PlacementTarget 容易跑出窗口），直接在窗口内盖一层 -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#C8000000" MouseLeftButtonDown="OnConfirmBackdropClick" />
            <Border Background="#FF30303A" BorderBrush="#5A5A66" BorderThickness="1"
                    CornerRadius="10" Padding="22,18" Width="460" MaxHeight="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                               FontFamily="Microsoft YaHei UI" />
                    <TextBlock Text="{Binding ConfirmMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" LineHeight="19"
                               Margin="0,8,0,0" FontFamily="Microsoft YaHei UI" />
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                                  Visibility="{Binding HasConfirmDetail, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ConfirmDetail}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}" LineHeight="17"
                                   FontFamily="Consolas, Microsoft YaHei UI" />
                    </ScrollViewer>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="3" Content="{Binding ConfirmOkText}" Height="32" MinWidth="88"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding ConfirmOkCommand}" />
                        <Button Grid.Column="1" Content="取消" Height="32" MinWidth="72"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ConfirmCancelCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
