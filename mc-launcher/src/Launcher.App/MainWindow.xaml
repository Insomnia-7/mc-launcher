<Window x:Class="Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Launcher.App.ViewModels"
        xmlns:views="clr-namespace:Launcher.App.Views"
             xmlns:anim="clr-namespace:Launcher.App.Animations"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MC Launcher" Height="740" Width="1120"
        MinHeight="560" MinWidth="820"
        Background="{DynamicResource BgBrush}"
        FontFamily="{StaticResource UiFontFamily}" FontSize="13" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
      <KeyBinding Modifiers="Control" Key="D1" Command="{Binding ShowInstancesCommand}"/>
      <KeyBinding Modifiers="Control" Key="D2" Command="{Binding ShowDownloadsCommand}"/>
      <KeyBinding Modifiers="Control" Key="OemComma" Command="{Binding OpenAppearanceCommand}"/>
      <KeyBinding Key="Escape" Command="{Binding CloseTopOverlayCommand}"/>
    </Window.InputBindings>
    <Grid x:Name="RootGrid" Background="{DynamicResource BgBrush}" TextElement.Foreground="{DynamicResource TextBrush}" TextElement.FontFamily="{StaticResource UiFontFamily}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" IsHitTestVisible="False">
          <Rectangle Fill="{DynamicResource BackdropGlowBrush}"/>
          <Image Source="{Binding WallpaperImage}" Stretch="UniformToFill" Opacity="{Binding WallpaperOpacity}"><Image.Effect><BlurEffect Radius="26" RenderingBias="Performance"/></Image.Effect></Image>
          <Rectangle Fill="{DynamicResource WallpaperTintBrush}"/>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush GradientOrigin="0.18,0.02" Center="0.18,0.02" RadiusX="0.95" RadiusY="0.85">
                            <GradientStop Color="#26FFFFFF" Offset="0" />
                            <GradientStop Color="#0DFFFFFF" Offset="0.55" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
        </Grid>
        <!-- ══════════ 左栏 ══════════ -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="20" Margin="14,14,0,8">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="16,20,14,18"><Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" HorizontalAlignment="Left"><TextBlock Text="M" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="MC Launcher" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="MINECRAFT JAVA" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0"/></StackPanel></Grid>
                <!-- 顶部两个分区按钮：游戏版本 / 下载 -->
                <Grid DockPanel.Dock="Top" Margin="12,0,12,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="游戏库" Height="36"
                            Command="{Binding ShowInstancesCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstanceSection}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2" Content="发现" Height="36"
                            Command="{Binding ShowDownloadsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloadSection}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <Button DockPanel.Dock="Bottom" Content="安装向导…" Command="{Binding OpenSetupCommand}" Margin="10,0,10,4" Height="36" Style="{StaticResource QuietButton}" />

                <Button DockPanel.Dock="Bottom" Content="网络设置…" Command="{Binding OpenNetworkCommand}" Margin="10,0,10,4" Height="36" Style="{StaticResource QuietButton}" />

                <Button DockPanel.Dock="Bottom" Content="外观与主题…" Command="{Binding OpenAppearanceCommand}" Margin="10,0,10,4" Height="36" Style="{StaticResource QuietButton}" ToolTip="主题、壁纸 · Ctrl+,"/>
                <!-- 版本列表 -->
                <ListBox x:Name="InstanceList" ItemsSource="{Binding Instances}"
                         SelectedItem="{Binding SelectedInstance}"
                         ItemContainerStyle="{StaticResource InstanceItem}"
                         Background="Transparent" BorderThickness="0"
                         Margin="8,0,8,12"
                         MouseDoubleClick="OnInstanceListDoubleClick"
                         Visibility="{Binding IsInstanceSection, Converter={StaticResource BoolToVis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ContextMenu>
                        <!-- ContextMenu 不在主视觉树里，绑不到窗口的 DataContext，要从 PlacementTarget 借 -->
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource LineBrush}">
                            <MenuItem Header="打开游戏目录" Command="{Binding OpenGameDirectoryCommand}" />
                            <MenuItem Header="打开版本目录" Command="{Binding OpenInstanceFolderCommand}" />
                            <MenuItem Header="打开日志目录" Command="{Binding OpenLogsCommand}" />
                            <Separator />
                            <MenuItem Header="删除版本…" Command="{Binding DeleteInstanceCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontSize="14"
                                           FontFamily="{StaticResource UiFontFamily}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontFamily="{StaticResource UiFontFamily}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 下载分类导航：游戏本体 + 模组 | 一条线 | 整合包 / 资源包 / 数据包 / 光影包 -->
                <ScrollViewer Margin="8,0,8,12"
                              Visibility="{Binding IsDownloadSection, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Download.Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <!-- 分隔项只画一条线 -->
                                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="6,8"
                                            Visibility="{Binding IsSeparator, Converter={StaticResource BoolToVis}}" />
                                    <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                                            Height="42" Margin="0,2" HorizontalContentAlignment="Stretch"
                                            Visibility="{Binding IsNormal, Converter={StaticResource BoolToVis}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                    CornerRadius="10" Padding="14,0">
                                                                <ContentPresenter VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding Title}" FontSize="13"
                                                   FontFamily="{StaticResource UiFontFamily}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ══════════ 右：版本页 ══════════ -->
        <ScrollViewer x:Name="LibraryPage" Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="Collapsed" anim:PageVisibility.IsActive="{Binding IsInstanceSection}">
            <Grid Margin="28,28,28,20" MaxWidth="1120">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,22">
                <TextBlock Text="{Binding SelectedInstance.DisplayName, FallbackValue='还没有版本'}"
                           Style="{StaticResource H1Text}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SelectedInstance.Subtitle, FallbackValue='先装一个版本'}"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 头像：正版取皮肤头部，离线用首字母；右下小圆点表示登录状态 -->
                        <Grid Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Border CornerRadius="8" Background="{DynamicResource FieldBrush}" ClipToBounds="True">
                                <Grid>
                                    <TextBlock Text="{Binding AccountInitial}" FontSize="15" FontWeight="SemiBold"
                                               Foreground="{DynamicResource MutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding SkinHead}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasSkinHead}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <Border Width="10" Height="10" CornerRadius="5" HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom" Margin="0,0,-2,-2" BorderThickness="2"
                                    BorderBrush="{DynamicResource CardBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource MutedBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAccount}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="{Binding AccountText}" FontSize="13" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding AccountDetail}" FontSize="12" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="账号管理…" Command="{Binding OpenAccountsCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0"/>
                            <Button Content="取消登录" Command="{Binding LoginCancelCommand}" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Margin="8,0,0,0"
                                    Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="{Binding LoginHint}" FontSize="12" Margin="2,8,0,0"
                           Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                           Visibility="{Binding IsLoggingIn, Converter={StaticResource BoolToVis}}" />
            </StackPanel>

            <Button Grid.Row="1" Content="启动游戏"
                    Style="{StaticResource PrimaryButton}" Height="52" FontSize="16" anim:PressFeedback.Scale="0.97"
                    Command="{Binding LaunchCommand}"
                    Margin="0,0,0,12" />

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="导入本地整合包（.mrpack / .zip）"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ImportModpackCommand}" />
                <Button Grid.Column="2" Content="导出备份…" MinWidth="118" Padding="16,0"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportInstanceCommand}" />
            </Grid>

            <StackPanel Grid.Row="4" Margin="0,0,0,20">
                <!-- 进度条同一行右侧挂「取消」：卡在 4px 条上太窄，用 Grid 两列，CanCancel 为假时按钮 Collapsed 不占位 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0" Height="4"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 VerticalAlignment="Center"
                                 Background="{DynamicResource FieldBrush}"
                                 Foreground="{DynamicResource AccentBrush}"
                                 BorderThickness="0" />

                    <Button Grid.Column="1" Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Height="26" FontSize="12" Padding="14,0" MinWidth="72"
                            Margin="12,0,0,0"
                            Command="{Binding CancelCommand}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- 启动失败诊断：把日志里的崩溃签名翻译成能照做的建议 -->
                <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="14,10" Margin="0,12,0,0"
                        Visibility="{Binding HasDiagnosis, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="启动失败" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DangerBrush}" FontFamily="{StaticResource UiFontFamily}" />
                        <TextBlock Text="{Binding DiagnosisText}" FontSize="12" TextWrapping="Wrap"
                                   LineHeight="19" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontFamily="{StaticResource UiFontFamily}" />
                        <!-- 一键把「诊断 + 版本 + 游戏目录 + 时间」贴进剪贴板，省得用户手抄日志路径 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="被拦截了？"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ShowBlockedHelpCommand}"
                                    Height="26" Padding="14,0" FontSize="12" Margin="0,0,8,0" />
                            <Button Content="复制诊断"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyDiagnosisCommand}"
                                    Visibility="{Binding HasDiagnosis, Converter={StaticResource BoolToVis}}"
                                    Height="26" Padding="14,0" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 版本设置：平时收起不占地方，展开可改内存 / Java / 额外参数 -->
            <Expander Grid.Row="5" IsExpanded="{Binding IsSettingsOpen, Mode=TwoWay}"
                      HorizontalContentAlignment="Stretch" Margin="0,0,0,14"
                      Foreground="{DynamicResource MutedBrush}">
                <Expander.Header>
                    <TextBlock Text="版本设置" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                </Expander.Header>
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="76" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="内存" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <Slider Grid.Column="1" Minimum="512" Maximum="32768"
                                    SmallChange="512" LargeChange="2048"
                                    TickFrequency="512" IsSnapToTickEnabled="True"
                                    Value="{Binding MemoryMb}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding MemoryMb, StringFormat='{}{0} MB'}"
                                       VerticalAlignment="Center" TextAlignment="Right" FontSize="12" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Java" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding JavaOptions}"
                                      SelectedItem="{Binding SelectedJava}" DisplayMemberPath="Title"
                                      Style="{StaticResource DarkComboBox}" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="档位" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding JvmPresetIndex}"
                                      Style="{StaticResource DarkComboBox}"
                                      ToolTip="默认：不加额外 JVM 参数；快速：G1 调优（在 Java 21 上实测反而慢一点，慎用）；兼容：只加 -XX:+UseG1GC">
                                <ComboBoxItem Content="默认" />
                                <ComboBoxItem Content="快速（G1 调优）" />
                                <ComboBoxItem Content="兼容（最保险）" />
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="下载源" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DownloadSources}"
                                      SelectedIndex="{Binding DownloadSourceIndex}"
                                      Style="{StaticResource DarkComboBox}"
                                      ToolTip="镜像走 bmclapi2.bangbang93.com，国内访问更快；切完下一批下载立刻生效，不用重启" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="JVM 参数" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding ExtraJvmArgs, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="-XX:+UseG1GC -XX:MaxGCPauseMillis=50 之类；空格分隔，带空格的参数用双引号包住" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="游戏参数" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding ExtraGameArgs, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="追加到游戏参数末尾，例如 --width 1920 --height 1080" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="窗口" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBox Grid.Column="1" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding WindowWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Text="×" Margin="8,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}" />
                            <TextBox Grid.Column="3" Style="{StaticResource DarkTextBox}"
                                     Text="{Binding WindowHeight, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding SettingsHint}" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="保存设置" Height="30" Width="92" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding SaveSettingsCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Expander>

            <!-- 模组：本地扫描 + 上游更新检查；更新会删旧文件再下新版，走确认气泡 -->
            <Expander Grid.Row="6" Margin="0,0,0,14" Foreground="{DynamicResource MutedBrush}"
                      HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <TextBlock Text="模组" FontSize="13" Foreground="{DynamicResource MutedBrush}" />
                </Expander.Header>
                <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ModSummary}" FontSize="12"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextBrush}" />
                            <Button Grid.Column="1" Content="刷新" Height="28" MinWidth="64" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RefreshModsCommand}" />
                            <Button Grid.Column="3" Content="检查更新" Height="28" MinWidth="80" FontSize="12"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CheckModUpdatesCommand}" />
                        </Grid>

                        <TextBlock Text="{Binding ModWarnings}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource WarnBrush}"
                                   Visibility="{Binding HasModWarnings, Converter={StaticResource BoolToVis}}" />

                        <ItemsControl ItemsSource="{Binding InstalledMods}" MaxHeight="220">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="4" Height="20" VerticalAlignment="Center"
                                                Background="{DynamicResource LineBrush}">
                                            <TextBlock Text="{Binding StateText}" FontSize="12" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Meta}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding ModUpdates}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding VersionText}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="12,0,12,0"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                        <Button Grid.Column="2" Content="更新" Height="26" MinWidth="60" FontSize="12"
                                                Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.UpdateModCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Expander>

            <Border Grid.Row="7" Style="{StaticResource CardBorder}"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyStateHint}" Style="{StaticResource BodyText}"
                               Foreground="{DynamicResource MutedBrush}"
                               TextWrapping="Wrap" LineHeight="22" />
                    <!-- 杀软误报是最常见的「打不开 / 启动就退」，把处置步骤做成随时能点的入口 -->
                    <Button Content="被安全软件拦住了？"
                            Command="{Binding ShowBlockedHelpCommand}"
                            Height="24" Padding="0" FontSize="12" Margin="0,10,0,0"
                            HorizontalAlignment="Left" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
            </Grid>
        </ScrollViewer>

        <!-- ══════════ 右：下载页 ══════════ -->
        <Grid x:Name="DownloadPage" Grid.Row="0" Grid.Column="1" Margin="28,28,28,16" MaxWidth="1120"
              Visibility="Collapsed" anim:PageVisibility.IsActive="{Binding IsDownloadSection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 当前目标 -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="{Binding Download.SelectedCategory.Title, FallbackValue='下载中心'}"
                           Style="{StaticResource H1Text}" />
                <TextBlock Text="{Binding Download.SelectedCategory.Hint}"
                           Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Download.TargetText}" Opacity="0.8"
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                            Visibility="{Binding Download.IsVersionMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="下载源" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}" Margin="0,0,10,0" />
                    <Button Content="官方" Height="26" Padding="14,0" FontSize="12"
                            Command="{Binding Download.UseDownloadSourceCommand}" CommandParameter="official">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Download.IsOfficialSource}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="BMCLAPI 镜像" Height="26" Padding="14,0" FontSize="12" Margin="8,0,0,0"
                            Command="{Binding Download.UseDownloadSourceCommand}" CommandParameter="bmclapi"
                            ToolTip="国内镜像。libraries / assets / Forge 与 Fabric maven 走镜像；client.jar 等大文件只做 302 回源，不会变快">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Download.IsBmclapiSource}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- All content kinds share source/category/version/sort and server-side paging. -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="18,16" Margin="0,0,0,14"
                        Visibility="{Binding Download.IsSearchMode, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <TextBlock Text="搜索资源" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                <Grid IsEnabled="{Binding Download.CanEditSearch}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource DarkTextBox}" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" Padding="8,0"
                             Background="{DynamicResource FieldBrush}" Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                             ToolTip="{Binding Download.SearchHint}" Text="{Binding Download.Query, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding Download.SearchCommand}"/></TextBox.InputBindings>
                    </TextBox>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Download.Sources}" SelectedItem="{Binding Download.SelectedSource}" ToolTip="下载来源"/>
                </Grid>
                <Grid Margin="0,8,0,0" IsEnabled="{Binding Download.CanEditSearch}"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.85*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,5"><TextBlock Text="游戏版本（可输入）" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox Height="32" IsEditable="True" ItemsSource="{Binding Download.GameVersions}" Text="{Binding Download.GameVersionFilter, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,5"><TextBlock Text="内容分类" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox Height="32" ItemsSource="{Binding Download.ResourceTags}" SelectedItem="{Binding Download.SelectedTag}" DisplayMemberPath="Name"/></StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,5" Visibility="{Binding Download.ShowsLoaderFilter, Converter={StaticResource BoolToVis}}"><TextBlock Text="加载器" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox Height="32" ItemsSource="{Binding Download.Loaders}" SelectedItem="{Binding Download.LoaderFilter}"/></StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,0,5"><TextBlock Text="排序" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox Height="32" ItemsSource="{Binding Download.SortOptions}" SelectedItem="{Binding Download.SelectedSort}" DisplayMemberPath="Name" ToolTip="{Binding Download.SortHint}"/></StackPanel>
                </Grid>
                <WrapPanel Margin="0,4,0,0">
                    <Button Content="搜索" Height="32" Padding="20,0" Margin="0,0,8,4" Style="{StaticResource PrimaryButton}" FontSize="13" Command="{Binding Download.SearchCommand}"/>
                    <Button Content="重置条件" Height="32" Padding="12,0" Margin="0,0,8,4" Style="{StaticResource SecondaryButton}" Command="{Binding Download.ResetFiltersCommand}"/>
                    <Button Content="热门推荐" Height="32" Padding="12,0" Margin="0,0,8,4" Style="{StaticResource SecondaryButton}" Command="{Binding Download.PopularCommand}"/>
                    <Button Content="安装已有整合包…" Height="32" Padding="12,0" Margin="0,0,0,4" Style="{StaticResource SecondaryButton}" Command="{Binding ImportModpackCommand}"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <!-- CurseForge 未配置提示 -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="8"
                    Padding="12,8" Margin="0,0,0,10"
                    Visibility="{Binding Download.ShowsCurseForgeHint, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" LineHeight="18"
                           Text="CurseForge 需要 API Key：到 console.curseforge.com 免费申请（Core 计划），填入数据目录下 settings.json 的 curseForgeApiKey，或设置环境变量 CURSEFORGE_API_KEY。Modrinth 源无需任何配置。" />
            </Border>

            <!-- 最新版本（PCL 样式：最新正式版 + 最新预览版） -->
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,10"
                    Visibility="{Binding Download.IsVersionMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="最新版本" FontSize="12" Margin="0,0,0,6"
                               Foreground="{DynamicResource MutedBrush}"
                               FontFamily="{StaticResource UiFontFamily}" />
                    <ItemsControl ItemsSource="{Binding Download.LatestVersions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}"
                                        HorizontalContentAlignment="Stretch" Height="34" Margin="0,1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="4" Padding="8,0">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13.5"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{StaticResource UiFontFamily}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ReleaseDateText}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="8,0,2,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontFamily="{StaticResource UiFontFamily}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <WrapPanel Grid.Row="3" Margin="0,0,0,10" Visibility="{Binding Download.IsSearchMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Download.ResultHeading}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,4"/>
                <Button Content="首页" Style="{StaticResource SecondaryButton}" Command="{Binding Download.FirstPageCommand}" Height="25" Margin="0,0,4,4" Padding="8,0"/>
                <Button Content="上一页" Style="{StaticResource SecondaryButton}" Command="{Binding Download.PreviousPageCommand}" Height="25" Margin="0,0,8,4" Padding="8,0"/>
                <TextBlock Text="{Binding Download.PageText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <Button Content="下一页" Style="{StaticResource SecondaryButton}" Command="{Binding Download.NextPageCommand}" Height="25" Margin="0,0,4,4" Padding="8,0"/>
                <Button Content="末页" Style="{StaticResource SecondaryButton}" Command="{Binding Download.LastPageCommand}" Height="25" Margin="0,0,0,4" Padding="8,0"/>
            </WrapPanel>

            <!-- 结果列表（两种模式共用一块区域）-->
            <Grid Grid.Row="4">
                <ListBox ItemsSource="{Binding Download.Results}"
                         SelectedItem="{Binding Download.SelectedResult}"
                         ItemContainerStyle="{StaticResource ResourceItem}"
                         Background="Transparent" BorderThickness="0"
                         Visibility="{Binding Download.IsSearchMode, Converter={StaticResource BoolToVis}}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource SelectedBrush}"
                                        CornerRadius="10" Width="40" Height="40" Padding="5,2" VerticalAlignment="Center"
                                        Margin="0,0,10,0" MinWidth="30">
                                    <TextBlock Text="{Binding Badge}" FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               FontFamily="{StaticResource UiFontFamily}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource MutedBrush}"
                                               FontFamily="{StaticResource UiFontFamily}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Author}" /><Run Text=" · " /><Run Text="{Binding MetaText}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Description}" FontSize="12"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontFamily="{StaticResource UiFontFamily}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 版本列表：按大版本号分组（26 / 1 / 23…），组里直接列完整版本号 -->
                <ScrollViewer Visibility="{Binding Download.IsVersionMode, Converter={StaticResource BoolToVis}}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Download.VersionGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,2">
                                    <Expander.Header>
                                        <TextBlock Text="{Binding Header}" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontFamily="{StaticResource UiFontFamily}" />
                                    </Expander.Header>
                                                    <ItemsControl ItemsSource="{Binding Versions}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Command="{Binding SelectCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        HorizontalContentAlignment="Stretch"
                                                                        Height="32" Margin="0,1">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Setter Property="BorderThickness" Value="0" />
                                                                            <Setter Property="Cursor" Value="Hand" />
                                                                            <Setter Property="Template">
                                                                                <Setter.Value>
                                                                                    <ControlTemplate TargetType="Button">
                                                                                        <Border x:Name="Bd"
                                                                                                Background="{TemplateBinding Background}"
                                                                                                CornerRadius="4" Padding="10,0">
                                                                                            <ContentPresenter VerticalAlignment="Center" />
                                                                                        </Border>
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="Bd" Property="Background"
                                                                                                        Value="{DynamicResource HoverBrush}" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="13"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextBrush}"
                                                                                   FontFamily="{StaticResource UiFontFamily}"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding ReleaseDateText}" FontSize="12"
                                                                                   VerticalAlignment="Center" Margin="8,0,2,0"
                                                                                   Foreground="{DynamicResource MutedBrush}"
                                                                                   FontFamily="{StaticResource UiFontFamily}" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- 进度 -->
            <StackPanel Grid.Row="5" Margin="0,12,0,0">
                <ProgressBar Height="4" Minimum="0" Maximum="100" Visibility="{Binding Download.IsBusy, Converter={StaticResource BoolToVis}}"
                             Value="{Binding Download.ProgressPercent}"
                             Background="{DynamicResource PanelBrush}"
                             Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0" Margin="0,0,0,10" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Download.Status}"
                               Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <!-- 状态文字右侧的「取消」：只在该页有任务时出现，不挤压右边的安装按钮 -->
                    <Button Grid.Column="1" Content="取消"
                            Style="{StaticResource SecondaryButton}"
                            Height="26" MinWidth="72" Padding="14,0" FontSize="12"
                            Margin="12,0,12,0" VerticalAlignment="Center"
                            Command="{Binding Download.CancelCommand}"
                            Visibility="{Binding Download.CanCancel, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="2" Content="安装到版本" Height="40" MinWidth="128"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding Download.InstallCommand}"
                            Visibility="{Binding Download.IsSearchMode, Converter={StaticResource BoolToVis}}" />

                    <Button Grid.Column="2" Content="下载并安装" Height="40" MinWidth="128"
                            Style="{StaticResource PrimaryButton}" anim:PressFeedback.Scale="0.97"
                            Command="{Binding Download.InstallVersionCommand}"
                            Visibility="{Binding Download.IsVersionMode, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </StackPanel>
        </Grid>

        <Image x:Name="CategorySnapshot" Grid.Row="0" Grid.Column="1" Margin="28,28,28,16" MaxWidth="1120" Stretch="Fill" IsHitTestVisible="False" Visibility="Collapsed" Panel.ZIndex="5"/>
        <!-- 底部状态条 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="Transparent" Height="30">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Margin="16,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource MutedBrush}"
                           FontFamily="{StaticResource UiFontFamily}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center"
                            Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding UpdateText}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="{StaticResource UiFontFamily}" Margin="0,0,10,0" />
                    <Button Content="立即更新" Command="{Binding ApplyUpdateCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Height="22" FontSize="12" Padding="12,0" MinWidth="72" />
                </StackPanel>
            </Grid>
        </Border>

        <views:AppearanceView anim:PageVisibility.Dialog="True" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="97" Visibility="Collapsed" anim:PageVisibility.IsActive="{Binding IsAppearanceOpen}"/>

        <!-- 切主题时铺一层旧底色淡出，避免整屏瞬间换色 -->
        <Border x:Name="ThemeFade" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="90"
                IsHitTestVisible="False" Opacity="0" Background="Transparent" />
        <views:NetworkSettingsView anim:PageVisibility.Dialog="True" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="96"
                                   Visibility="Collapsed" anim:PageVisibility.IsActive="{Binding IsNetworkOpen}" />

        <views:FirstRunView anim:PageVisibility.Dialog="True" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="90"
                            Visibility="Collapsed" anim:PageVisibility.IsActive="{Binding IsSetupOpen}" />

        <views:AccountManagerView anim:PageVisibility.Dialog="True" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="95"
                                  Visibility="Collapsed" anim:PageVisibility.IsActive="{Binding IsAccountsOpen}" />

        <!-- 确认覆盖层：不用 Popup（PlacementTarget 容易跑出窗口），直接在窗口内盖一层 -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="100"
              Visibility="Collapsed" anim:PageVisibility.IsActive="{Binding IsConfirmOpen}" anim:PageVisibility.Dialog="True">
            <Border Background="{DynamicResource OverlayBrush}" MouseLeftButtonDown="OnConfirmBackdropClick" />
            <Border x:Name="ConfirmSurface" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    CornerRadius="20" Padding="26,22" Width="460" MaxHeight="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"
                               FontFamily="{StaticResource UiFontFamily}" />
                    <TextBlock Text="{Binding ConfirmMessage}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedBrush}" LineHeight="19"
                               Margin="0,8,0,0" FontFamily="{StaticResource UiFontFamily}" />
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                                  Visibility="{Binding HasConfirmDetail, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ConfirmDetail}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedBrush}" LineHeight="17"
                                   FontFamily="Consolas, Microsoft YaHei UI" />
                    </ScrollViewer>
                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="3" Content="{Binding ConfirmOkText}" Height="32" MinWidth="88"
                                Style="{StaticResource PrimaryButton}" anim:PressFeedback.Scale="0.97"
                                Command="{Binding ConfirmOkCommand}" />
                        <Button Grid.Column="1" Content="取消" Height="32" MinWidth="72"
                                Style="{StaticResource SecondaryButton}"
                                Command="{Binding ConfirmCancelCommand}"
                                Visibility="{Binding ConfirmShowCancel, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>