<Project Sdk="Microsoft.NET.Sdk">

  <!-- 测试夹具，不在 MinecraftLauncher.sln 里。用来复现「更新器内嵌在主程序里」的解压与执行路径。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>probe-embed</AssemblyName>
    <RootNamespace>ProbeEmbed</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 与 Launcher.App.csproj 的补丁同一个做法：把已发布的 mclupd.exe 作为嵌入资源编进主程序 -->
    <EmbeddedResource Include="$(UpdaterPayload)" LogicalName="Launcher.Updater.mclupd.exe"
                      Condition="'$(UpdaterPayload)' != ''" />
  </ItemGroup>

</Project>
