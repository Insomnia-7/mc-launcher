<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System">
  <Styles.Resources>
    <!-- 默认初始色表（Dark 基准，启动时由 AppearanceManager 动态同步 Dark / Light / System） -->
    <SolidColorBrush x:Key="BgBrush" Color="#101114" />
    <SolidColorBrush x:Key="PanelBrush" Color="#14161B" />
    <SolidColorBrush x:Key="CardBrush" Color="#191C22" />
    <SolidColorBrush x:Key="FieldBrush" Color="#1F232B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#262B35" />
    <SolidColorBrush x:Key="PressedBrush" Color="#303642" />
    <SolidColorBrush x:Key="LineBrush" Color="#2A2E37" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#22262E" />
    <SolidColorBrush x:Key="TextBrush" Color="#F1F2F5" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A0A4AF" />
    <SolidColorBrush x:Key="FaintBrush" Color="#737987" />
    <SolidColorBrush x:Key="AccentBrush" Color="#8B7CFF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9A8DFF" />
    <SolidColorBrush x:Key="AccentFillBrush" Color="#7466E5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6254D4" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#292440" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#292440" />
    <SolidColorBrush x:Key="AccentStrongBrush" Color="#8B7CFF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4FBF83" />
    <SolidColorBrush x:Key="WarnBrush" Color="#E6B65C" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E06C75" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#24E06C75" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#A608090C" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF" />

    <!-- Mica 生效时仅顶栏与侧栏使用高不透明度透底，内容卡片保持实色确保可读性 -->
    <SolidColorBrush x:Key="MicaShellTintBrush" Color="#E6101114" />
    <SolidColorBrush x:Key="MicaSidebarBrush" Color="#DE14161B" />

    <!-- 字体栈（UI.md §14） -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, Segoe UI, sans-serif</FontFamily>

    <!-- 字号阶梯（UI.md §14） -->
    <sys:Double x:Key="FontSizePageTitle">26</sys:Double>
    <sys:Double x:Key="FontSizeSectionTitle">18</sys:Double>
    <sys:Double x:Key="FontSizeCardTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeBody">14</sys:Double>
    <sys:Double x:Key="FontSizeCaption">12</sys:Double>
    <sys:Double x:Key="FontSizeBadge">11</sys:Double>

    <!-- 4px 间距体系（UI.md §14） -->
    <Thickness x:Key="SpaceMicro">4</Thickness>
    <Thickness x:Key="SpaceCompact">8</Thickness>
    <Thickness x:Key="SpaceRegular">12</Thickness>
    <Thickness x:Key="SpaceStandard">16</Thickness>
    <Thickness x:Key="SpaceMedium">20</Thickness>
    <Thickness x:Key="SpaceModule">24</Thickness>

    <!-- 分级圆角（UI.md §14：禁止所有控件使用同一圆角） -->
    <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="RadiusButton">8</CornerRadius>
    <CornerRadius x:Key="RadiusCard">12</CornerRadius>
    <CornerRadius x:Key="RadiusDialog">16</CornerRadius>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="Background" Value="{DynamicResource BgBrush}" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <Style Selector="TextBlock.page-title">
    <Setter Property="FontSize" Value="{StaticResource FontSizePageTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="{StaticResource FontSizeSectionTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.card-title">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCardTitle}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="FontSize" Value="{StaticResource FontSizeBadge}" />
    <Setter Property="Foreground" Value="{DynamicResource FaintBrush}" />
  </Style>
</Styles>
