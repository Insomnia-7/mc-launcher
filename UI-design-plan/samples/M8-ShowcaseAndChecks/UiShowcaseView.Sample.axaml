<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Launcher.App.ViewModels"
             xmlns:icons="using:Launcher.Desktop.Controls"
             x:DataType="vm:MainViewModel"
             x:Class="Launcher.Desktop.Views.Dev.UiShowcaseView">
  <!--
    遵循 UI.md §29「UI Showcase 开发预览页」：
    仅供开发与视觉验收使用（仅当环境变量 FANGYU_DEV_SHOWCASE=1 时激活入口），不出现在普通用户的正式菜单中。
  -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Margin="24,16,24,24">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="方隅 UI V1.1 设计系统预览（开发模式）" Classes="page-title" />
          <TextBlock Text="集中检视深浅色 Token、按钮 8 态、侧边栏 240/72 伸缩、弹窗缩放与四态 Toast。" Classes="secondary" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="切换主题 (Dark/Light/System)" Command="{Binding CycleThemeModeCommand}" />
          <Button Content="收起/展开侧边栏 (240↔72)" Command="{Binding ToggleSidebarDevCommand}" />
        </StackPanel>
      </Grid>

      <!-- 1. 按钮状态矩阵 -->
      <Border Classes="card" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="1. 按钮状态矩阵（Normal / Hover / Pressed / Disabled / Loading / Success / Error）" Classes="card-title" />
          <WrapPanel>
            <Button Classes="primary" Content="主操作按钮 (Primary)" Margin="0,0,10,10" />
            <Button Content="次操作按钮 (Secondary)" Margin="0,0,10,10" />
            <Button Classes="ghost" Content="轻量按钮 (Ghost)" Margin="0,0,10,10" />
            <Button Classes="primary" IsEnabled="False" Content="禁用态 (Disabled)" Margin="0,0,10,10" />
            <Button Classes="is-loading" Content="加载中 (Loading…)" Margin="0,0,10,10" />
            <Button Classes="is-success" Content="操作成功 (Success)" Margin="0,0,10,10" />
            <Button Classes="is-error" Content="操作失败 (Error)" Margin="0,0,10,10" />
            <Button Classes="danger-solid" Content="危险确认 (Danger)" Margin="0,0,10,10" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- 2. Toast 四态与弹窗动画触发 -->
      <Border Classes="card" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Text="2. 弹窗（Scale 0.97→1）与右下角四态队列 Toast 预览" Classes="card-title" />
          <WrapPanel>
            <Button Content="触发成功 Toast" Command="{Binding TriggerDemoToastCommand}" CommandParameter="success" Margin="0,0,10,10" />
            <Button Content="触发警告 Toast" Command="{Binding TriggerDemoToastCommand}" CommandParameter="warning" Margin="0,0,10,10" />
            <Button Content="触发错误 Toast" Command="{Binding TriggerDemoToastCommand}" CommandParameter="error" Margin="0,0,10,10" />
            <Button Content="触发普通 Toast" Command="{Binding TriggerDemoToastCommand}" CommandParameter="info" Margin="0,0,10,10" />
            <Button Content="打开新建实例弹窗" Command="{Binding OpenSetupCommand}" Margin="0,0,10,10" />
            <Button Content="重播首屏交错入场动效" Command="{Binding ReplayHomeStaggerCommand}" Margin="0,0,10,10" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
